{
    "name": "huat-fsac-docs",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "clean": "rimraf .astro dist",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css,json,mjs}\" \"*.{json,mjs,ts}\"",
        "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,css,json,mjs}\" \"*.{json,mjs,ts}\"",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "quality:bundle": "node scripts/quality/check-bundle-budget.mjs",
        "quality:lighthouse": "lhci collect --config=.config/lighthouserc.json && lhci assert --config=.config/lighthouserc.json",
        "metrics:collect": "node scripts/metrics/collect-github-metrics.mjs",
        "dev:worker": "wrangler pages dev dist --compatibility-date=2024-04-01",
        "prepare": "husky"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.9",
        "@astrojs/cloudflare": "^14.1.4",
        "@astrojs/starlight": "^0.41.4",
        "astro": "^7.1.3",
        "qrcode": "^1.5.4",
        "sharp": "^0.34.5",
        "typescript": "^5.9.3"
    },
    "pnpm": {
        "overrides": {
            "minimatch@<3.1.3": ">=3.1.3",
            "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
            "ajv@<6.14.0": "~6.14.0",
            "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
            "yaml@<2.8.3": ">=2.8.3",
            "vitest@>=4.0.0 <4.1.0": ">=4.1.0",
            "brace-expansion": "5.0.8",
            "postcss@>=8.0.0 <8.5.18": ">=8.5.18",
            "js-yaml@>=4.0.0 <4.3.0": "~4.3.0",
            "fast-uri@<3.1.4": ">=3.1.4",
            "ws@<8.21.0": ">=8.21.0",
            "vite@>=6.0.0 <6.4.3": ">=6.4.3",
            "vite@>=7.0.0 <7.3.5": ">=7.3.5",
            "astro@>=7.0.0 <7.0.6": ">=7.0.6",
            "astro@>=7.0.0 <7.1.0": ">=7.1.0",
            "sharp@>=0.34.0 <0.35.0": ">=0.35.0",
            "svgo@<4.0.2": ">=4.0.2",
            "undici@<7.28.0": ">=7.28.0"
        }
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260425.1",
        "@commitlint/cli": "^20.4.2",
        "@commitlint/config-conventional": "^20.4.2",
        "@fullhuman/postcss-purgecss": "^8.0.0",
        "@playwright/test": "^1.61.0",
        "@types/qrcode": "^1.5.6",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^9.9.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-astro": "^1.2.3",
        "husky": "^9.0.11",
        "jsdom": "^28.1.0",
        "lint-staged": "^15.2.10",
        "prettier": "^3.3.3",
        "rimraf": "^6.1.3",
        "terser": "^5.46.1",
        "typescript-eslint": "^8.0.0",
        "vite-plugin-purgecss": "^0.2.13",
        "vitest": "^4.1.10",
        "wrangler": "4.114.0"
    },
    "packageManager": "pnpm@9.15.9",
    "engines": {
        "node": ">=22.0.0"
    }
}
