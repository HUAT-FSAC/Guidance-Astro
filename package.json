{
    "name": "huat-fsac-docs",
    "type": "module",
    "version": "0.0.1",
    "private": true,
    "description": "HUAT FSAC 方程式赛车队官方文档站点 — 基于 Astro 7 + Starlight + Cloudflare Workers SSR 的中英双语站点,含 PWA、多主题、Pagefind 搜索与安全加固。",
    "license": "MIT",
    "author": {
        "name": "HUAT FSAC",
        "url": "https://github.com/HUAT-FSAC",
        "email": "opensrc@huat-fsac.eu.org"
    },
    "homepage": "https://huat-fsac.eu.org",
    "repository": {
        "type": "git",
        "url": "https://github.com/HUAT-FSAC/Guidance-Astro.git"
    },
    "bugs": {
        "url": "https://github.com/HUAT-FSAC/Guidance-Astro/issues",
        "email": "opensrc@huat-fsac.eu.org"
    },
    "keywords": [
        "astro",
        "starlight",
        "cloudflare-workers",
        "ssr",
        "documentation",
        "pwa",
        "mdx",
        "pagefind",
        "huat-fsac",
        "formula-student"
    ],
    "funding": {
        "type": "individual",
        "url": "https://huat-fsac.eu.org/sponsor"
    },
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro build",
        "deploy:worker": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
        "patch:cf-pages": "node scripts/patch-cf-pages.mjs",
        "preview": "astro preview",
        "preview:ssr": "wrangler dev dist/server/entry.mjs --config dist/server/wrangler.json --port 8787",
        "astro": "astro",
        "clean": "rimraf .astro dist",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css,json,mjs}\" \"*.{json,mjs,ts}\"",
        "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,css,json,mjs}\" \"*.{json,mjs,ts}\"",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "quality:bundle": "node scripts/quality/check-bundle-budget.mjs",
        "quality:theme": "node scripts/quality/check-theme-contrast.mjs",
        "quality:lighthouse": "lhci collect --config=.config/lighthouserc.json && lhci assert --config=.config/lighthouserc.json",
        "metrics:collect": "node scripts/metrics/collect-github-metrics.mjs",
        "dev:worker": "wrangler pages dev dist --compatibility-date=2024-04-01",
        "prepare": "husky"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.9",
        "@astrojs/cloudflare": "^14.1.4",
        "@astrojs/starlight": "^0.41.4",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fontsource/space-grotesk": "^5.3.0",
        "astro": "^7.1.3",
        "qrcode": "^1.5.4",
        "sharp": "^0.35.0",
        "typescript": "^5.9.3"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260425.1",
        "@commitlint/cli": "^20.4.2",
        "@commitlint/config-conventional": "^20.4.2",
        "@fullhuman/postcss-purgecss": "^8.0.0",
        "@playwright/test": "^1.61.0",
        "@types/qrcode": "^1.5.6",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^9.9.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-astro": "^1.2.3",
        "husky": "^9.0.11",
        "jsdom": "^28.1.0",
        "lint-staged": "^15.2.10",
        "prettier": "^3.3.3",
        "rimraf": "^6.1.3",
        "terser": "^5.51.2",
        "typescript-eslint": "^8.0.0",
        "vite-plugin-purgecss": "^0.2.13",
        "vitest": "^4.1.10",
        "wrangler": "4.114.0"
    },
    "packageManager": "pnpm@11.22.0",
    "engines": {
        "node": ">=22.0.0"
    }
}
