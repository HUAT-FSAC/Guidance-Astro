#!/usr/bin/env sh
. "$(dirname "$0")/ensure-pnpm.sh"

# 1) 密钥扫描(可选,未装 gitleaks 时静默跳过)
#    跳过方式:GITLEAKS_SKIP=1 git commit ...
#    安装:https://github.com/gitleaks/gitleaks#installing
if [ -x "$(dirname "$0")/pre-commit-secret-scan" ]; then
    sh "$(dirname "$0")/pre-commit-secret-scan"
fi

# 2) Lint + Prettier(必走)
pnpm lint-staged --config .config/lint-staged.config.mjs
