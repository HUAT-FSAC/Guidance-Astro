#!/usr/bin/env sh
# 在 lint-staged 之前单独运行 gitleaks,扫描本次 commit 的全部分变更。
# 避免 lint-staged 只对 staged 部分扫描、漏掉已 staged 但不属于某 glob 的文件。
# 安装:brew install gitleaks / choco install gitleaks / apt:见 https://github.com/gitleaks/gitleaks
# 跳过:GITLEAKS_SKIP=1 git commit ...

set -e

if [ -n "$GITLEAKS_SKIP" ]; then
    echo "⏭️  GITLEAKS_SKIP set, skipping gitleaks"
    exit 0
fi

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "⚠️  gitleaks not installed — skipping pre-commit secret scan."
    echo "    Install: https://github.com/gitleaks/gitleaks#installing"
    echo "    (set GITLEAKS_SKIP=1 to bypass, or use CI scan in .github/workflows/secret-scan.yml)"
    exit 0
fi

echo "🔍 Running gitleaks against staged changes…"
gitleaks protect --staged --redact --no-banner \
    --config .gitleaks.toml \
    --verbose
