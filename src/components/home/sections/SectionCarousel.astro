---
interface Props {
    labels?: string[]
}
const { labels } = Astro.props
---

<div class="sc-carousel" id="scCarousel">
    <div class="sc-viewport">
        <div class="sc-track" id="scTrack">
            <slot />
        </div>
    </div>

    <div class="sc-nav" id="scNav">
        {labels && labels.map((label, i) => (
            <button class="sc-dot" data-index={i} title={label} aria-label={label}>●</button>
        ))}
    </div>
</div>

<script>
    function initCarousel() {
        const trackElement = document.getElementById('scTrack') as HTMLElement | null
        const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.sc-dot'))
        if (!trackElement || !dots.length) return
        const track = trackElement

        const slides = Array.from(track.children).filter(function (el) {
            return el.tagName !== 'SCRIPT' && el.tagName !== 'STYLE'
        })
        if (slides.length === 0) return

        let current = 0

        slides.forEach(el => {
            const slide = el as HTMLElement
            slide.style.flex = '0 0 100%'
            slide.style.minWidth = '0'
            slide.style.maxWidth = '100%'
            slide.style.boxSizing = 'border-box'
            slide.style.overflow = 'hidden'
        })

        function showSlide(index: number) {
            current = index
            track.style.transform = 'translateX(-' + (current * 100) + '%)'
            dots.forEach(function (d, i) { d.classList.toggle('active', i === current) })
        }

        dots.forEach(function (dot) {
            dot.addEventListener('click', function () {
                const idx = Number.parseInt(dot.dataset.index ?? '0', 10)
                showSlide(idx)
            })
        })

        showSlide(0)
    }

    document.addEventListener('astro:page-load', initCarousel)
    initCarousel()
</script>

<style>
    .sc-carousel {
        position: relative;
        overflow: hidden;
        width: 100%;
        background: #000;
    }

    .sc-viewport {
        overflow: hidden;
        width: 100%;
    }

    .sc-track {
        display: flex;
        transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
        width: 100%;
        will-change: transform;
    }

    .sc-nav {
        position: fixed;
        right: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        z-index: 100;
    }

    .sc-dot {
        background: none;
        border: none;
        color: var(--fs-color-text-dimmed);
        font-size: 0.75rem;
        cursor: pointer;
        padding: 0.25rem;
        transition: all 0.3s ease;
        line-height: 1;
    }

    .sc-dot:hover {
        color: var(--fs-color-text-muted);
        transform: scale(1.3);
    }

    .sc-dot.active {
        color: var(--sl-color-accent);
        transform: scale(1.5);
    }

    @media (max-width: 768px) {
        .sc-nav { right: 0.75rem; gap: 0.5rem; }
        .sc-dot { font-size: 0.6rem; }
    }
</style>
