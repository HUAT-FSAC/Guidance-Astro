---
import type { Locale } from '../../../utils/i18n';
import { getLocaleFromPath, getTranslations } from '../../../utils/i18n';

interface Props {
    locale?: Locale;
}

const { locale = getLocaleFromPath(Astro.url.pathname) } = Astro.props;
const t = getTranslations(locale);

const groupLinks = [
    {
        icon: 'eye',
        link: '/archive/2025/sensing/',
    },
    {
        icon: 'route',
        link: '/archive/2025/planning-control/',
    },
    {
        icon: 'map',
        link: '/archive/2025/localization-mapping/',
    },
    {
        icon: 'simulation',
        link: '/archive/2025/simulation/',
    },
    {
        icon: 'wind',
        link: '/archive/2025/mechanical/',
    },
    {
        icon: 'chassis',
        link: '/archive/2025/mechanical/',
    },
    {
        icon: 'bolt',
        link: '/archive/2025/electrical/',
    },
    {
        icon: 'chart',
        link: '/archive/2025/management/',
    },
    {
        icon: 'battery',
        link: '/archive/2025/electrical/',
    },
];

const groups = groupLinks.map((group, index) => ({
    ...group,
    ...t.coreModules.groups[index],
}));
---

<section class="groups-section" aria-label={t.coreModules.ariaLabel}>
    <div class="groups-grid">
        {groups.map((group, i) => (
            <a href={group.link} class="group-card reveal-upon-scroll" style={`transition-delay: ${i * 0.08}s;`}>
                <div class="group-icon">
                    {group.icon === 'eye' && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    )}
                    {group.icon === 'route' && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/></svg>
                    )}
                    {group.icon === 'map' && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
                    )}
                    {group.icon === 'simulation' && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    )}
                    {group.icon === 'wind' && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/></svg>
                    )}
                    {group.icon === 'chassis' && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                    )}
                    {group.icon === 'bolt' && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    )}
                    {group.icon === 'chart' && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    )}
                    {group.icon === 'battery' && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="18" height="12" rx="2" ry="2"/><line x1="23" y1="13" x2="23" y2="11"/><line x1="11" y1="10" x2="11" y2="14"/><line x1="8" y1="12" x2="14" y2="12"/></svg>
                    )}
                </div>
                <h3 class="group-name">{group.name}</h3>
                <p class="group-desc">{group.desc}</p>
            </a>
        ))}
    </div>
</section>

<style>
    .groups-section {
        padding: 2rem 0 4rem;
    }

    .groups-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .group-card {
        display: block;
        text-decoration: none !important;
        background: var(--fs-color-card-bg);
        border: 1px solid var(--fs-border-subtle);
        border-radius: 12px;
        padding: 2.5rem 1.5rem 2rem;
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .group-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 30px rgba(59,130,246,0.12);
        border-color: var(--sl-color-accent);
    }

    .group-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 1.2rem;
        border-radius: 50%;
        background: var(--sl-color-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--fs-color-on-image);
    }

    .group-name {
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0 0 0.75rem;
        color: var(--fs-color-heading);
    }

    .group-desc {
        font-size: 0.9rem;
        line-height: 1.7;
        color: var(--fs-color-text-dimmed);
        margin: 0;
        opacity: 0.7;
    }

    :global([data-theme='light']) .group-card {
        background: var(--fs-color-card-bg);
        border-color: var(--fs-border-subtle);
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    }

    :global([data-theme='light']) .group-card:hover {
        box-shadow: 0 8px 30px rgba(59,130,246,0.1);
    }

    @media (max-width: 900px) {
        .groups-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .groups-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
