---
interface Props{
    backgroundImage?:string
}
const { backgroundImage } = Astro.props
const bgStyle = backgroundImage ? `--team-bg: url(${backgroundImage});` : ''
---

<section class="team-hero fs-full-bleed" role="region" aria-label="Team">
    <div class="team-bg" role="presentation" aria-hidden="true" style={bgStyle}></div>
    <div class="team-overlay" role="presentation" aria-hidden="true"></div>
    <div class="team-content">
        <h2 class="team-heading">指导老师与团队成员</h2>
        <span class="team-sub">ADVISORS & TEAM MEMBERS</span>
        <a class="team-cta fs-cta-clip" href="/team/" role="button" data-astro-prefetch="hover">查看完整团队</a>
    </div>
</section>

<style>
    .team-hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: var(--fs-bg-base);
    }

    .team-bg {
        position: absolute;
        inset: 0;
        background-image: var(--team-bg);
        background-size: cover;
        background-position: center;
        opacity: 0.5;
        pointer-events: none;
    }

    .team-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 0%, var(--fs-color-overlay-soft) 40%, var(--fs-color-overlay-strong) 100%);
        pointer-events: none;
    }

    .team-content {
        position: relative;
        z-index: 3;
        text-align: center;
        padding: 4rem 2rem;
        max-width: 900px;
        border: 1px solid var(--fs-color-border-strong);
        border-radius: 4px;
    }

    .team-content .team-heading {
        font-size: clamp(3rem, 7vw, 5rem);
        margin: 0 0 1rem 0;
        font-weight: 900;
        letter-spacing: 0.1em;
        line-height: 1.1;
        color: var(--fs-color-on-image);
        text-shadow: 0 10px 30px var(--fs-color-overlay-soft);
    }

    .team-content .team-sub {
        display: block;
        color: var(--fs-color-on-image);
        font-size: 1.2rem;
        letter-spacing: 2px;
        margin: 0 0 2.5rem 0;
        font-weight: 400;
    }

    /* CTA 样式由共享工具类 .fs-cta-clip 提供（见 docs-global.css） */
    @media (hover: hover) and (pointer: fine) {
        .team-cta:hover {
            color: var(--fs-color-on-accent) !important; /* theme-contrast:allow */
        }
    }

    @media (max-width: 480px) {
        .team-content { padding: 1.5rem 0; }
        .team-cta { width: 100%; justify-content: center; }
    }
</style>