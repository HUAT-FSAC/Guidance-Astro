---
interface Props{
    backgroundImage?:string
}
const { backgroundImage } = Astro.props
const bgStyle = backgroundImage ? `--team-bg: url(${backgroundImage});` : ''
---

<section class="team-hero" role="region" aria-label="Team">
    <div class="team-bg" role="presentation" aria-hidden="true" style={bgStyle}></div>
    <div class="team-overlay" role="presentation" aria-hidden="true"></div>
    <div class="team-content">
        <div class="team-label">OUR TEAM</div>
        <h1 class="team-heading">指导老师与团队成员</h1>
        <p class="team-sub">Advisors & Team Members</p>
        <a class="team-cta" href="/team/" role="button" data-astro-prefetch="hover">查看完整团队</a>
    </div>
</section>

<style>
    .team-hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: #000;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
    }

    .team-bg {
        position: absolute;
        inset: 0;
        background-image: var(--team-bg);
        background-size: cover;
        background-position: center;
        opacity: 0.5;
        pointer-events: none;
    }

    .team-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.4) 40%, rgba(0,0,0,0.85) 100%);
        pointer-events: none;
    }

    .team-content {
        position: relative;
        z-index: 3;
        text-align: center;
        padding: 4rem 2rem;
        max-width: 900px;
    }

    .team-label {
        color: var(--sl-color-accent);
        font-weight: 800;
        letter-spacing: 6px;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
    }

    .team-content .team-heading {
        font-size: clamp(3rem, 7vw, 5rem);
        margin: 0 0 2rem 0;
        font-weight: 900;
        letter-spacing: 0.1em;
        line-height: 1.1;
        color: #ffffff;
        text-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .team-content .team-sub {
        color: #ffffff;
        font-size: 1.2rem;
        margin: -1rem 0 2rem 0;
        font-weight: 400;
        letter-spacing: 2px;
    }

    .team-cta {
        display: inline-flex;
        padding: 1rem 3rem;
        color: #3b82f6;
        border: 1px solid var(--sl-color-accent);
        font-weight: 700;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
    }

    @media (max-width: 480px) {
        .team-content { padding: 1.5rem 0; }
        .team-cta { width: 100%; justify-content: center; }
    }
</style>