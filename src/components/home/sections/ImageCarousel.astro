---
interface Props {
    images: { src: string; alt: string }[];
    interval?: number;
}

const { images } = Astro.props;
const id = 'carousel-' + Math.random().toString(36).slice(2, 8);
const interval = Astro.props.interval ?? 3000;
---

<div class="carousel" id={id} data-interval={interval}>
    {images.map((img, i) => (
        <img
            src={img.src}
            alt={img.alt}
            class="carousel-image"
            data-index={i}
            style={{ display: i === 0 ? 'block' : 'none' }}
            width="800"
            height="450"
            loading="lazy"
            decoding="async"
        />
    ))}
    <div class="carousel-dots">
        {images.map((_, i) => (
            <button class="dot" data-index={i} data-active={i === 0 ? '' : undefined}></button>
        ))}
    </div>
</div>

<script>
    (function () {
        const container = document.currentScript?.closest('.carousel') as HTMLElement | null;
        if (!container) return;
        const images = Array.from(container.querySelectorAll<HTMLImageElement>('.carousel-image'));
        const dots = Array.from(container.querySelectorAll<HTMLButtonElement>('.dot'));
        if (!images.length || !dots.length) return;

        const intervalMs = Number(container.dataset.interval ?? 3000);
        let current = 0;
        let timer = window.setInterval(function () {
            const currentImage = images[current] as HTMLImageElement;
            const currentDot = dots[current] as HTMLButtonElement;
            currentImage.style.display = 'none';
            currentDot.removeAttribute('data-active');
            current = (current + 1) % images.length;
            images[current].style.display = 'block';
            dots[current].setAttribute('data-active', '');
        }, intervalMs);

        container.addEventListener('mouseenter', function () { window.clearInterval(timer); });
        container.addEventListener('mouseleave', function () {
            timer = window.setInterval(function () {
                const currentImage = images[current] as HTMLImageElement;
                const currentDot = dots[current] as HTMLButtonElement;
                currentImage.style.display = 'none';
                currentDot.removeAttribute('data-active');
                current = (current + 1) % images.length;
                images[current].style.display = 'block';
                dots[current].setAttribute('data-active', '');
            }, intervalMs);
        });

        dots.forEach(function (dot) {
            dot.addEventListener('click', function () {
                const idx = Number.parseInt(dot.getAttribute('data-index') ?? '0', 10);
                if (idx === current) return;
                images[current].style.display = 'none';
                dots[current].removeAttribute('data-active');
                current = idx;
                images[current].style.display = 'block';
                dots[current].setAttribute('data-active', '');
            });
        });
    })();
</script>

<style>
    .carousel {
        position: relative;
        width: 100%;
        border-radius: 10px;
        overflow: hidden;
    }
    .carousel-image {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 10px;
        filter: brightness(0.5);
        transition: opacity 0.5s;
    }
    .carousel-dots {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 8px;
    }
    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: none;
        background: rgba(255,255,255,0.5);
        cursor: pointer;
        padding: 0;
        transition: background 0.3s;
    }
    .dot[data-active] {
        background: #fff;
    }
</style>
