---
import ImageCarousel from './ImageCarousel.astro';
import type { Locale } from '../../../utils/i18n';
import { getLocaleFromPath, getTranslations } from '../../../utils/i18n';

interface Props {
  locale?: Locale;
}

const { locale = getLocaleFromPath(Astro.url.pathname) } = Astro.props;
const t = getTranslations(locale);
---

<section class="home-block" style="max-width: 80%; min-height: 65vh;">
  <div class="home-block-header" style="text-align: center;">
    <span class="home-block-label">{t.about.label}</span>
    <span class="home-block-subtitle">ABOUT US</span>
  </div>
  <div style="display: flex; gap: 5rem; align-items: center;">
    <div style="flex: 1.6;">
      <div class="about-content">
        {t.about.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
    <div style="flex: 1;">
      <ImageCarousel images={[
        { src: '/assets/about-us.jpg', alt: t.about.teamPhotoAlt },
      ]} interval={3000} />
    </div>
  </div>
</section>

<style>
  .about-content {
    line-height: 1.8;
    font-size: 1.3rem;
    color: var(--sl-color-text);
    opacity: 0.85;
    max-width: 1000px;
  }
  .about-content p {
    text-indent: 2em;
  }

  .home-block-label {
    font-size: 3rem !important;
    font-weight: 800;
    color: var(--fs-color-heading);
    border-bottom: 3px solid var(--sl-color-accent);
    padding-bottom: 10px;
    display: inline-block;
  }

  .home-block-subtitle {
    display: block;
    margin-top: 0.75rem;
    font-size: 1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--fs-color-heading);
  }

  section.home-block {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .home-block-header {
    margin-bottom: 8rem !important;   /* 改这个值，越大距离越远 */
  }

  @media (max-width: 1000px) {
    section.home-block > div:last-child {
      flex-direction: column !important;
    }
  }
</style>
