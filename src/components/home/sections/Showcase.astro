---
import type { Locale } from '../../../utils/i18n';
import { getLocaleFromPath, getTranslations } from '../../../utils/i18n';

interface Props {
    locale?: Locale;
}

const { locale = getLocaleFromPath(Astro.url.pathname) } = Astro.props;
const t = getTranslations(locale);

const module = {
    cn: t.showcase?.modules?.[0]?.title ?? '智能驾驶实验室',
    en: 'SHOWCASE LAB',
    link: locale === 'en' ? '/en/showcase-dashboard/' : '/showcase-dashboard/',
    image: '/assets/huat.jpg',
    desc: t.showcase?.modules?.[0]?.desc ?? '用完全本地的数据、SVG 可视化和浏览器状态管理，直观展示无人驾驶赛车从感知到执行器的整条闭环。',
};
---

<section class="showcase-hero fs-full-bleed" role="region" aria-label={t.showcase?.ariaLabel ?? '功能模块'}>
    <div class="showcase-slide-bg" style={`background-image: url(${module.image});`}></div>
    <div class="showcase-overlay"></div>

    <div class="showcase-content">
        <span class="showcase-en">{module.en}</span>
        <h2 class="showcase-title">{module.cn}</h2>
        <p class="showcase-desc">{module.desc}</p>
        <a class="showcase-cta fs-cta-clip" href={module.link}>
            {t.common.learnMore}
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
    </div>
</section>

<style>
    .showcase-hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: #0a0a0c;
        margin-top: -60px;
        padding-top: 60px;
        z-index: 5;
    }

    .showcase-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 60px;
        background: #0a0a0c;
        z-index: 3;
    }

    :global([data-theme='light']) .showcase-hero::before {
        background: #ffffff;
    }

    .showcase-slide-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
    }

    .showcase-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.7);
        pointer-events: none;
        z-index: 1;
    }

    .showcase-content {
        position: relative;
        z-index: 4;
        text-align: center;
        padding: 4rem 2rem;
        max-width: 800px;
    }

    .showcase-en {
        display: block;
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 6px;
        color: var(--fs-color-on-image) !important;
        margin-bottom: 1.5rem;
    }

    .showcase-title {
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: clamp(3rem, 8vw, 5.5rem);
        font-weight: 900;
        color: var(--fs-color-on-image) !important;
        margin: 0 0 1.5rem;
        line-height: 1.1;
        text-shadow: 0 4px 20px rgba(0,0,0,0.6), 0 2px 8px rgba(0,0,0,0.4);
    }

    .showcase-desc {
        font-size: 1.25rem;
        line-height: 1.8;
        color: var(--fs-color-on-image) !important;
        margin: 0 0 2.5rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .showcase-cta {
        background: transparent !important;
        color: #2563eb !important;
        border: 2px solid #2563eb !important;
        border-radius: 50px !important;
    }
    .showcase-cta::before {
        display: none;
    }
    .showcase-cta svg {
        transition: transform 0.3s ease;
    }
    .showcase-cta:hover {
        background: #2563eb !important;
        color: var(--fs-color-on-accent) !important;
        border-color: #2563eb !important;
    }
    .showcase-cta:hover svg {
        transform: translateX(4px);
    }

    @media (max-width: 768px) {
        .showcase-content { padding: 2rem 1.5rem; }
    }
</style>
