---
const modules = [
    {
        cn: '智能驾驶实验室',
        en: 'SHOWCASE LAB',
        link: '/showcase-dashboard/',
    },
    {
        cn: '征服赛道',
        en: 'CONQUER THE TRACK',
        link: '/cars/',
    },
    {
        cn: '认识团队',
        en: 'MEET THE TEAM',
        link: '/team/',
    },
    {
        cn: 'Formula Student',
        en: 'GLOBAL COMPETITION',
        link: '/about-fs/',
    },
];
---

<section class="showcase-section reveal-upon-scroll" aria-label="模块展示">
    <div class="home-block-header" style="text-align: center; margin-bottom: 4rem;">
        <span class="home-block-label">功能模块</span>
    </div>
    <div class="showcase-container">
        <!-- 左栏：模块卡片 -->
        <div class="showcase-left reveal-upon-scroll">
            <div class="showcase-card-grid">
                {modules.map((mod, i) => (
                    <a href={mod.link} class="showcase-card" style={`transition-delay: ${i * 0.1}s;`}>
                        <span class="showcase-card-icon">
                            {mod.cn === '智能驾驶实验室' && (
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 16H9m-6-4h.01M3 12c0-4.97 4.03-9 9-9s9 4.03 9 9-4.03 9-9 9a9.06 9.06 0 0 1-4.5-1.2L3 21l1.2-4.5A8.96 8.96 0 0 1 3 12z"/></svg>
                            )}
                            {mod.cn === '征服赛道' && (
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                            )}
                            {mod.cn === '认识团队' && (
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            )}
                            {mod.cn === 'Formula Student' && (
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                            )}
                        </span>
                        <span class="showcase-card-cn">{mod.cn}</span>
                        <span class="showcase-card-en">{mod.en}</span>
                    </a>
                ))}
            </div>
        </div>

        <!-- 中栏：主视觉 -->
        <div class="showcase-center reveal-upon-scroll">
            <div class="showcase-monitor">
                <img
                    src="/assets/huat.jpg"
                    alt="HUAT 赛车"
                    class="showcase-image"
                    loading="lazy"
                />
                <span class="showcase-label">FSAC-25 LIVE</span>
            </div>
        </div>

    </div>
</section>

<style>
    .showcase-section {
        padding: 6rem 3rem;
        margin: 0;
        overflow: hidden;
        position: relative;
        width: 100%;
        box-sizing: border-box;
    }

    .home-block-label {
        font-size: 2.5rem !important;
    }

    .showcase-container {
        display: flex;
        gap: 4rem;
        align-items: stretch;
        width: 100%;
        position: relative;
        z-index: 1;
    }

    /* ======== 左栏：模块卡片网格 ======== */
    .showcase-left {
        flex: 1;
        display: flex;
        align-items: stretch;
        min-width: 0;
    }

    .showcase-card-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        width: 100%;
    }

    .showcase-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1.25rem 0.75rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.75rem;
        text-decoration: none !important;
        color: inherit !important;
        transition: all 0.25s ease;
        text-align: center;
        cursor: pointer;
    }

    .showcase-card:hover {
        background: rgba(59, 130, 246, 0.1);
        border-color: rgba(59, 130, 246, 0.35);
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    .showcase-card-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #1e3a5f;
        color: #93c5fd;
        transition: all 0.25s ease;
    }

    .showcase-card:hover .showcase-card-icon {
        background: #2563eb;
        color: #ffffff;
        box-shadow: 0 0 14px rgba(59, 130, 246, 0.5);
    }

    .showcase-card-cn {
        display: block;
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.3;
    }

    .showcase-card-en {
        display: block;
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 3px;
        color: rgba(255, 255, 255, 0.35);
        text-transform: uppercase;
        transition: color 0.25s ease;
    }

    .showcase-card:hover .showcase-card-en {
        color: var(--sl-color-accent);
    }

    /* ======== 中栏：主视觉 ======== */
    .showcase-center {
        flex: 1.4;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
    }

    .showcase-monitor {
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 2px;
        overflow: hidden;
        position: relative;
        width: 100%;
        aspect-ratio: 4/3;
        background: rgba(0, 0, 0, 0.4);
    }
    .showcase-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.5);
        box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        display: block;
    }

    .showcase-label {
        position: absolute;
        bottom: 0.6rem;
        right: 0.8rem;
        font-family: 'Space Grotesk', monospace;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 3px;
        color: rgba(255, 255, 255, 0.5);
        background: rgba(0, 0, 0, 0.7);
        padding: 0.2rem 0.6rem;
        border-radius: 2px;
    }

    /* ======== 浅色模式 ======== */
    :global([data-theme='light']) .showcase-card {
        background: rgba(0, 0, 0, 0.03);
        border-color: rgba(0, 0, 0, 0.08);
    }

    :global([data-theme='light']) .showcase-card:hover {
        background: rgba(59, 130, 246, 0.06);
        border-color: rgba(59, 130, 246, 0.3);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    }

    :global([data-theme='light']) .showcase-card-icon {
        background: #dbeafe;
        color: #2563eb;
    }

    :global([data-theme='light']) .showcase-card:hover .showcase-card-icon {
        background: #2563eb;
        color: #fff;
    }

    :global([data-theme='light']) .showcase-card-cn {
        color: #000000;
    }

    :global([data-theme='light']) .showcase-card-en {
        color: rgba(0, 0, 0, 0.35);
    }

    :global([data-theme='light']) .showcase-card:hover .showcase-card-en {
        color: var(--sl-color-accent);
    }

    :global([data-theme='light']) .showcase-monitor {
        border-color: rgba(0, 0, 0, 0.15);
        background: rgba(255, 255, 255, 0.6);
    }

    /* ======== 响应式 ======== */
    @media (max-width: 768px) {
        .showcase-section {
            padding: 3rem 1.25rem;
        }

        .showcase-container {
            flex-direction: column;
            gap: 2.5rem;
        }

        .showcase-card-grid {
            gap: 0.5rem;
        }

        .showcase-card {
            padding: 1rem 0.5rem;
        }

        .showcase-monitor {
            aspect-ratio: 16/9;
        }
    }
</style>
