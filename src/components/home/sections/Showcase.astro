---
const modules = [
    {
        cn: '智能驾驶实验室',
        en: 'SHOWCASE LAB',
        link: '/showcase-dashboard/',
        image: '/assets/huat.jpg',
        desc: '用完全本地的数据、SVG 可视化和浏览器状态管理，直观展示无人驾驶赛车从感知到执行器的整条闭环。',
    },
    {
        cn: '征服赛道',
        en: 'CONQUER THE TRACK',
        link: '/cars/',
        image: '/assets/run.jpg',
        desc: '欢迎来到 HUAT FSAC - 见证我们如何用前沿的电动和无人驾驶技术重新定义赛车运动。',
    },
    {
        cn: '新闻动态',
        en: 'LATEST NEWS',
        link: '/news/',
        image: '/assets/about-us.jpg',
        desc: '关注车队最新动态，了解赛事进展、团队活动和技术突破。',
    },
    {
        cn: 'Formula Student',
        en: 'GLOBAL COMPETITION',
        link: '/about-fs/',
        image: '/assets/formula.jpg',
        desc: 'Formula Student 是全球最顶尖的工程赛事之一，600多支队伍从零开始设计制造赛车。',
    },
];
---

<section class="showcase-hero" role="region" aria-label="功能模块">
    {modules.map((mod, i) => (
        <div class={`showcase-slide ${i === 0 ? 'active' : ''}`} data-index={i}>
            <div class="showcase-slide-bg" style={`background-image: url(${mod.image});`}></div>
        </div>
    ))}
    <div class="showcase-overlay"></div>

    <div class="showcase-content">
        <span class="showcase-en" id="showcase-en">{modules[0].en}</span>
        <h2 class="showcase-title" id="showcase-title">{modules[0].cn}</h2>
        <p class="showcase-desc" id="showcase-desc">{modules[0].desc}</p>
        <a class="showcase-cta" id="showcase-cta" href={modules[0].link}>
            了解更多
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
    </div>

    <button class="showcase-arrow showcase-arrow-left" id="showcase-prev" aria-label="上一个">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button class="showcase-arrow showcase-arrow-right" id="showcase-next" aria-label="下一个">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
    </button>

    <div class="showcase-dots" id="showcase-dots">
        {modules.map((_, i) => (
            <button class={`showcase-dot ${i === 0 ? 'active' : ''}`} data-index={i}></button>
        ))}
    </div>
</section>

<script define:vars={{ modules: JSON.stringify(modules) }}>
    (function() {
        const data = JSON.parse(modules);
        let current = 0;
        const slides = document.querySelectorAll('.showcase-slide');
        const titleEl = document.getElementById('showcase-title');
        const enEl = document.getElementById('showcase-en');
        const descEl = document.getElementById('showcase-desc');
        const ctaEl = document.getElementById('showcase-cta');
        const dots = document.querySelectorAll('.showcase-dot');
        const total = data.length;

        function goTo(index) {
            slides[current].classList.remove('active');
            dots[current].classList.remove('active');
            current = (index + total) % total;
            slides[current].classList.add('active');
            dots[current].classList.add('active');
            titleEl.textContent = data[current].cn;
            enEl.textContent = data[current].en;
            descEl.textContent = data[current].desc;
            ctaEl.href = data[current].link;
        }

        document.getElementById('showcase-prev').addEventListener('click', function() { goTo(current - 1); });
        document.getElementById('showcase-next').addEventListener('click', function() { goTo(current + 1); });

        dots.forEach(function(dot) {
            dot.addEventListener('click', function() {
                goTo(parseInt(dot.getAttribute('data-index')));
            });
        });

        let timer = setInterval(function() { goTo(current + 1); }, 5000);
        const section = document.querySelector('.showcase-hero');
        section.addEventListener('mouseenter', function() { clearInterval(timer); });
        section.addEventListener('mouseleave', function() {
            timer = setInterval(function() { goTo(current + 1); }, 5000);
        });
    })();
</script>

<style>
    .showcase-hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: #000;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
    }

    /* 幻灯片 */
    .showcase-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 0.8s ease;
        pointer-events: none;
    }
    .showcase-slide.active {
        opacity: 1;
    }
    .showcase-slide-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        opacity: 0.7;
    }

    /* 遮罩 */
    .showcase-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.55);
        pointer-events: none;
        z-index: 1;
    }

    /* 内容 */
    .showcase-content {
        position: relative;
        z-index: 2;
        text-align: center;
        padding: 4rem 2rem;
        max-width: 800px;
    }

    .showcase-en {
        display: block;
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 6px;
        color: #ffffff !important;
        margin-bottom: 1.5rem;
    }

    .showcase-title {
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: clamp(3rem, 8vw, 5.5rem);
        font-weight: 900;
        color: #ffffff !important;
        margin: 0 0 1.5rem;
        line-height: 1.1;
        text-shadow: 0 4px 20px rgba(0,0,0,0.6), 0 2px 8px rgba(0,0,0,0.4);
    }

    .showcase-desc {
        font-size: 1.25rem;
        line-height: 1.8;
        color: #ffffff !important;
        margin: 0 0 2.5rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .showcase-cta {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        padding: 1rem 3rem;
        color: #fff !important;
        background: transparent !important;
        border: 1px solid var(--sl-color-accent) !important;
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-weight: 700;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
        transition: all 0.3s var(--fs-ease-out);
        clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);
        overflow: hidden;
    }

    :global([data-theme='light']) .showcase-cta {
        color: var(--sl-color-accent) !important;
    }

    .showcase-cta::before {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: var(--sl-color-accent);
        z-index: -1;
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.4s var(--fs-ease-out);
    }

    .showcase-cta:hover {
        color: #000 !important;
        border-color: transparent !important;
        box-shadow: 0 0 20px var(--fs-accent-glow) !important;
    }

    .showcase-cta:hover::before {
        transform: scaleX(1);
        transform-origin: left;
    }

    .showcase-cta svg {
        transition: transform 0.3s ease;
    }
    .showcase-cta:hover svg {
        transform: translateX(4px);
    }

    /* 左右箭头 */
    .showcase-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 3;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 50%;
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        cursor: pointer;
        transition: all 0.3s ease;
        backdrop-filter: blur(8px);
    }
    .showcase-arrow:hover {
        background: var(--sl-color-accent);
        border-color: var(--sl-color-accent);
        color: #000;
        box-shadow: 0 0 20px var(--fs-accent-glow);
    }
    .showcase-arrow-left { left: 3rem; }
    .showcase-arrow-right { right: 3rem; }

    /* 底部圆点 */
    .showcase-dots {
        position: absolute;
        bottom: 2.5rem;
        left: 0;
        right: 0;
        z-index: 3;
        display: flex;
        justify-content: center;
        gap: 0.75rem;
    }
    .showcase-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.4);
        background: transparent;
        cursor: pointer;
        padding: 0;
        transition: all 0.3s ease;
    }
    .showcase-dot.active {
        background: var(--sl-color-accent);
        border-color: var(--sl-color-accent);
        box-shadow: 0 0 10px var(--fs-accent-glow);
    }
    .showcase-dot:hover {
        border-color: var(--sl-color-accent);
    }

    /* 响应式 */
    @media (max-width: 768px) {
        .showcase-content { padding: 2rem 1.5rem; }
        .showcase-arrow { width: 40px; height: 40px; }
        .showcase-arrow-left { left: 1rem; }
        .showcase-arrow-right { right: 1rem; }
    }
</style>
