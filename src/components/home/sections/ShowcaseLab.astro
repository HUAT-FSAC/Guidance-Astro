---
import { showcaseScenarios } from '../../../data/showcase-lab'
import type { ShowcaseContent } from '../../../data/home'

interface Props {
    content?: ShowcaseContent
}

const defaultScenario = showcaseScenarios[0]
const fallbackContent: ShowcaseContent = {
    href: '/showcase-dashboard/',
    title: '智能驾驶交互实验室',
    subtitle: 'AUTONOMOUS SHOWCASE',
    description: '用完全本地的数据、SVG 可视化和浏览器状态管理，直观展示无人驾驶赛车从感知到执行器的整条闭环。',
    features: ['多场景预设', '实时可视化', '离线演示'],
    cta: '进入实验室',
    preview: {
        title: defaultScenario.name,
        subtitle: defaultScenario.tagline,
    },
}

const { content = fallbackContent } = Astro.props
---

<section class="showcase-entry home-block">
    <div class="showcase-entry-shell">
        <div class="showcase-entry-content">
            <h2 class="showcase-entry-heading">{content.title}</h2>
            <span class="showcase-entry-subtitle">{content.subtitle}</span>
            <p class="showcase-entry-description">{content.description}</p>
            <div class="showcase-entry-features">
                {content.features.map((feature) => (
                    <div class="feature-item">
                        <span class="feature-icon">◉</span>
                        <span>{feature}</span>
                    </div>
                ))}
            </div>
            <a href={content.href} class="fs-cta-clip">
                <span>{content.cta}</span>
                <span class="cta-arrow">→</span>
            </a>
        </div>
        <div class="showcase-entry-preview">
            <div class="preview-card">
                <div class="preview-track">
                    <svg viewBox="0 0 320 180" class="track-svg">
                        <defs>
                            <linearGradient id="preview-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="#3b82f6"></stop>
                                <stop offset="100%" stop-color="#818cf8"></stop>
                            </linearGradient>
                        </defs>
                        <path class="track-path" d="M 40 140 Q 80 40 160 90 Q 240 140 280 60"></path>
                        <path class="track-progress" d="M 40 140 Q 80 40 160 90 Q 200 115 220 100"></path>
                        <circle class="track-car" cx="220" cy="100" r="8"></circle>
                        <circle class="marker cone" cx="60" cy="25" r="4"></circle>
                        <circle class="marker cone" cx="120" cy="35" r="4"></circle>
                        <circle class="marker cone" cx="180" cy="45" r="4"></circle>
                        <circle class="marker cone" cx="240" cy="35" r="4"></circle>
                        <circle class="marker cone" cx="60" cy="155" r="4"></circle>
                        <circle class="marker cone" cx="120" cy="145" r="4"></circle>
                        <circle class="marker cone" cx="180" cy="135" r="4"></circle>
                        <circle class="marker cone" cx="240" cy="145" r="4"></circle>
                        <circle class="marker gate" cx="50" cy="90" r="4"></circle>
                        <circle class="marker gate" cx="270" cy="70" r="4"></circle>
                    </svg>
                </div>
                <div class="preview-info">
                    <span class="preview-scenario">{content.preview.title}</span>
                    <span class="preview-tagline">{content.preview.subtitle}</span>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .showcase-entry {
        max-width: none;
        margin: 0;
        padding: 6rem 2rem;
        background: var(--fs-bg-base);
        border-top: 1px solid var(--fs-border-subtle);
    }

    .showcase-entry-shell {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 4rem;
        align-items: center;
    }

    .showcase-entry-content {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        align-items: flex-start;
    }

    .showcase-entry-heading {
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: clamp(2.5rem, 5vw, 3.5rem);
        font-weight: 800;
        line-height: 1.1;
        margin: 0;
        color: var(--fs-color-heading);
        border-bottom: 3px solid var(--sl-color-accent);
        padding-bottom: 0.5rem;
        display: inline-block;
    }

    .showcase-entry-subtitle {
        display: block;
        font-size: 0.85rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--sl-color-accent);
    }

    .showcase-entry-description {
        font-size: 1.1rem;
        line-height: 1.7;
        color: var(--fs-color-text-muted);
        margin: 0;
    }

    .showcase-entry-features {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        color: var(--fs-color-text-dimmed);
    }

    .feature-icon {
        color: var(--sl-color-accent);
        font-size: 0.6rem;
    }

    .cta-arrow {
        transition: transform 0.25s var(--fs-ease-out);
    }

    .showcase-entry-content :global(.fs-cta-clip:hover) .cta-arrow {
        transform: translateX(4px);
    }

    .showcase-entry-preview {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .preview-card {
        width: 100%;
        max-width: 400px;
        background: var(--fs-bg-surface);
        border: 1px solid var(--fs-border-subtle);
        overflow: hidden;
        box-shadow: var(--card-shadow);
    }

    .preview-track {
        padding: 1.5rem;
        background: var(--fs-color-aside-bg);
    }

    .track-svg {
        width: 100%;
        height: auto;
    }

    .track-path {
        fill: none;
        stroke: var(--fs-color-border-strong);
        stroke-width: 16;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .track-progress {
        fill: none;
        stroke: url(#preview-gradient);
        stroke-width: 8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .track-car {
        fill: var(--fs-color-heading);
        stroke: var(--sl-color-accent);
        stroke-width: 2.5;
    }

    .marker {
        stroke: var(--fs-bg-base);
        stroke-width: 1.5;
    }

    .marker.cone {
        fill: var(--sl-color-accent);
    }

    .marker.gate {
        fill: color-mix(in srgb, var(--sl-color-accent) 70%, white);
    }

    .preview-info {
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .preview-scenario {
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--fs-color-heading);
    }

    .preview-tagline {
        font-size: 0.85rem;
        color: var(--fs-color-text-dimmed);
    }

    @media (max-width: 900px) {
        .showcase-entry-shell {
            grid-template-columns: 1fr;
            gap: 3rem;
            text-align: center;
        }

        .showcase-entry-content {
            align-items: center;
        }

        .showcase-entry-features {
            justify-content: center;
        }
    }

    @media (max-width: 600px) {
        .showcase-entry {
            padding: 4rem 1.25rem;
        }

        .showcase-entry-features {
            flex-direction: column;
            gap: 0.75rem;
            align-items: center;
        }
    }
</style>