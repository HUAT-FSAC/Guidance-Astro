---
import { optimizeExternalImage } from '../../../utils/image-optimization'
import ArrowRight from '../../icons/ArrowRight.astro'

interface Props {
    title: string
    subtitle: string
    description: string
    ctaText: string
    ctaLink: string
    backgroundImages?: string[]
}

const { title, subtitle, description, ctaText, ctaLink, backgroundImages } = Astro.props

const images = (backgroundImages ?? []).map((src) => ({
    large: src ? optimizeExternalImage(src, 1600, 80) : '',
    small: src ? optimizeExternalImage(src, 900, 80) : '',
}))
---

{/* preload first image */}
{images.length > 0 && (
    <link rel="preload" as="image" href={images[0].large} fetchpriority="high" />
)}

<section class="hero-v2 fs-full-bleed" role="region" aria-label="Hero">
    {images.length > 0 ? (
        images.map((img, i) => (
            <div
                class={`hero-bg hero-bg-${i}`}
                role="presentation"
                aria-hidden="true"
                style={`--hero-bg: url(${img.large}); --hero-bg-mobile: url(${img.small});`}
                data-parallax
                data-parallax-speed="0.25"
            ></div>
        ))
    ) : (
        <div class="hero-bg hero-bg-0" role="presentation" aria-hidden="true" data-parallax data-parallax-speed="0.25"></div>
    )}
    <div class="hero-overlay" role="presentation" aria-hidden="true"></div>

    <div class="hero-inner">
        <div class="hero-label">FORMULA STUDENT</div>
        <h1 class="hero-heading">{title}</h1>
        {subtitle && <div class="hero-sub">{subtitle}</div>}
        {description && <p class="hero-desc">{description}</p>}

        <a
            class="hero-cta fs-cta-clip"
            href={ctaLink}
            role="button"
            data-astro-prefetch="hover"
            aria-label={`${ctaText} - 开始探索赛车队内容`}
        >
            <span class="hero-cta-text">{ctaText}</span>
            <ArrowRight size={18} aria-hidden="true" />
        </a>
    </div>
</section>

<!-- 占位块：hero 是 fixed，需要推动后续内容到可视区以下 -->
<script>
    import { createLogger } from '../../../utils/logger'

    const log = createLogger('Hero')

    const bgLayers = document.querySelectorAll<HTMLElement>('.hero-bg')
    log.info('扫描背景图层', { found: bgLayers.length })

    if (bgLayers.length > 1) {
        let current = 0
        let interval: number
        const total = bgLayers.length

        function showSlide(index: number) {
            bgLayers.forEach((el, i) => {
                el.style.opacity = i === index ? '1' : '0'
                el.style.transition = 'opacity 1s ease-in-out'
            })
        }

        function nextSlide() {
            const prev = current
            current = (current + 1) % total
            showSlide(current)
            log.info('切换背景图', { from: prev, to: current, total })
        }

        function startCarousel() {
            interval = window.setInterval(nextSlide, 5000)
            log.info('自动轮播已启动', { intervalMs: 5000, total })
        }

        function stopCarousel() {
            clearInterval(interval)
            log.info('自动轮播已暂停（hover）')
        }

        const hero = document.querySelector('.hero-v2')
        hero?.addEventListener('mouseenter', stopCarousel)
        hero?.addEventListener('mouseleave', startCarousel)

        // init: show first, hide others
        bgLayers.forEach((el, i) => {
            el.style.opacity = i === 0 ? '1' : '0'
            el.style.transition = 'opacity 1s ease-in-out'
        })

        startCarousel()
    } else {
        log.info('背景图层数 ≤ 1，跳过轮播逻辑')
    }
</script>

<style>
    .hero-v2 {
        position: relative;
        margin-top: calc(-1 * var(--sl-navbar-height, 3.5rem));
        padding-top: var(--sl-navbar-height, 3.5rem);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: var(--fs-bg-base);
    }

    :global([data-theme='light']) .hero-v2 {
        background-color: var(--fs-bg-surface);
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        background-image: var(--hero-bg);
        background-size: cover;
        background-position: center center;
        background-color: var(--fs-bg-base);
        opacity: 0;
        filter: brightness(0.5);
        pointer-events: none;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            color-mix(in srgb, var(--fs-bg-base) 30%, transparent) 0%,
            color-mix(in srgb, var(--fs-bg-base) 50%, transparent) 50%,
            color-mix(in srgb, var(--fs-bg-base) 85%, transparent) 100%
        );
        pointer-events: none;
    }

    :global([data-theme='light']) .hero-overlay {
        background: linear-gradient(180deg, color-mix(in srgb, var(--fs-bg-base) 20%, transparent) 0%, color-mix(in srgb, var(--fs-bg-base) 40%, transparent) 50%, color-mix(in srgb, var(--fs-bg-base) 75%, transparent) 100%);
    }

    .hero-inner {
        position: relative;
        z-index: 3;
        text-align: center;
        padding: 4rem 2rem;
        max-width: 900px;
    }

    .hero-label {
        color: var(--sl-color-accent);
        font-weight: 800;
        letter-spacing: 6px;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
        font-family: 'Space Grotesk', system-ui, sans-serif;
    }

    .hero-heading {
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: clamp(3rem, 7vw, 5rem);
        margin: 0 0 1.5rem 0;
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 1.1;
        color: var(--fs-color-heading);
        text-shadow: 0 10px 30px color-mix(in srgb, var(--fs-bg-base) 50%, transparent);
    }

    :global([data-theme='light']) .hero-heading {
        text-shadow: none;
    }

    .hero-sub {
        color: var(--fs-color-heading);
        margin-bottom: 1.5rem;
        font-weight: 700;
        font-size: 1.5rem;
    }

    .hero-desc {
        color: var(--fs-color-text-muted);
        margin: 0 auto 3rem auto;
        max-width: 1000px;
        line-height: 1.8;
        white-space: pre-line;
        font-size: 1.4rem;
    }

    /* CTA 样式由共享工具类 .fs-cta-clip 提供（见 docs-global.css） */

    @media (max-width: 900px) {
        .hero-v2 {
            padding: 4rem 1.5rem;
        }
        .hero-bg {
            background-image: var(--hero-bg-mobile, var(--hero-bg));
        }
    }

    @media (max-width: 480px) {
        .hero-v2 {
            padding: 3rem 1rem;
            margin-bottom: 2rem;
        }
        .hero-inner {
            padding: 1.5rem 0;
        }
        .hero-desc {
            font-size: 1rem;
        }
        .hero-cta {
            width: 100%;
            justify-content: center;
        }
    }
</style>
