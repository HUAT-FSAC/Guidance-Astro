---
import { optimizeExternalImage } from '../../../utils/image-optimization'
import ArrowRight from '../../icons/ArrowRight.astro'

interface Props {
    title: string
    subtitle: string
    description: string
    ctaText: string
    ctaLink: string
    backgroundImages?: string[]
}

const { title, subtitle, description, ctaText, ctaLink, backgroundImages } = Astro.props

const images = (backgroundImages ?? []).map((src) => ({
    large: src ? optimizeExternalImage(src, 1600, 80) : '',
    small: src ? optimizeExternalImage(src, 900, 80) : '',
}))
---

{/* preload first image */}
{images.length > 0 && (
    <link rel="preload" as="image" href={images[0].large} fetchpriority="high" />
)}

<section class="hero-v2" role="region" aria-label="Hero">
    {images.length > 0 ? (
        images.map((img, i) => (
            <div
                class={`hero-bg hero-bg-${i}`}
                role="presentation"
                aria-hidden="true"
                style={`--hero-bg: url(${img.large}); --hero-bg-mobile: url(${img.small});`}
                data-parallax
                data-parallax-speed="0.25"
            ></div>
        ))
    ) : (
        <div class="hero-bg hero-bg-0" role="presentation" aria-hidden="true" data-parallax data-parallax-speed="0.25"></div>
    )}
    <div class="hero-overlay" role="presentation" aria-hidden="true"></div>

    <div class="hero-inner">
        <div class="hero-label">FORMULA STUDENT</div>
        <h1 class="hero-heading">{title}</h1>
        {subtitle && <div class="hero-sub">{subtitle}</div>}
        {description && <p class="hero-desc">{description}</p>}

        <a
            class="hero-cta"
            href={ctaLink}
            role="button"
            data-astro-prefetch="hover"
            aria-label={`${ctaText} - 开始探索赛车队内容`}
        >
            <span class="hero-cta-text">{ctaText}</span>
            <ArrowRight size={18} aria-hidden="true" />
        </a>
    </div>
</section>

<script>
    const bgLayers = document.querySelectorAll<HTMLElement>('.hero-bg')
    if (bgLayers.length > 1) {
        let current = 0
        let interval: number
        const total = bgLayers.length

        function showSlide(index: number) {
            bgLayers.forEach((el, i) => {
                el.style.opacity = i === index ? '0.5' : '0'
                el.style.transition = 'opacity 1s ease-in-out'
            })
        }

        function nextSlide() {
            current = (current + 1) % total
            showSlide(current)
        }

        function startCarousel() {
            interval = window.setInterval(nextSlide, 5000)
        }

        function stopCarousel() {
            clearInterval(interval)
        }

        const hero = document.querySelector('.hero-v2')
        hero?.addEventListener('mouseenter', stopCarousel)
        hero?.addEventListener('mouseleave', startCarousel)

        // init: show first, hide others
        bgLayers.forEach((el, i) => {
            el.style.opacity = i === 0 ? '0.5' : '0'
            el.style.transition = 'opacity 1s ease-in-out'
        })

        startCarousel()
    }
</script>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700;900&display=swap');

    .hero-v2 {
        position: relative;
        min-height: 100vh;
        padding: 6rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 0;
        margin: 0 auto 0 auto;
        max-width: 100%;
        background-color: var(--fs-bg-base);
        background-image: 
            linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
        background-size: 50px 50px;
        border-bottom: 1px solid var(--fs-border-subtle);
    }

    :global([data-theme='light']) .hero-v2 {
        background-color: #f8f9fa;
        background-image: 
            linear-gradient(rgba(0,0,0,0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(0,0,0,0.03) 1px, transparent 1px);
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        background-image: var(--hero-bg);
        background-size: cover;
        background-position: center center;
        opacity: 0;
        pointer-events: none;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(3, 3, 3, 0) 0%, rgba(3, 3, 3, 0.4) 40%, rgba(3, 3, 3, 0.85) 100%);
        pointer-events: none;
    }

    :global([data-theme='light']) .hero-overlay {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.4) 40%, rgba(255, 255, 255, 0.85) 100%);
    }

    .hero-inner {
        position: relative;
        z-index: 3;
        text-align: center;
        padding: 4rem 2rem;
        max-width: 900px;
    }

    .hero-label {
        color: var(--sl-color-accent);
        font-weight: 800;
        letter-spacing: 6px;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
        font-family: 'Space Grotesk', system-ui, sans-serif;
    }

    .hero-heading {
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: clamp(3rem, 7vw, 5rem);
        margin: 0 0 1.5rem 0;
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 1.1;
        color: #ffffff;
        text-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    :global([data-theme='light']) .hero-heading {
        color: #050505;
        text-shadow: none;
    }

    .hero-sub {
        color: #ffffff;
        margin-bottom: 1.5rem;
        font-weight: 700;
        font-size: 1.5rem;
    }

    .hero-desc {
        color: #ffffff;
        margin: 0 auto 3rem auto;
        max-width: 1000px;
        line-height: 1.8;
        white-space: pre-line;
        font-size: 1.4rem;
    }

    :global([data-theme='light']) .hero-desc {
        color: rgba(0, 0, 0, 0.7);
    }

    .hero-cta {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        padding: 1rem 3rem;
        color: #fff !important;
        background: transparent !important;
        border: 1px solid var(--sl-color-accent) !important;
        border-radius: 0 !important;
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-weight: 700;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
        transition: all 0.3s var(--fs-ease-out);
        clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);
        overflow: hidden;
    }

    :global([data-theme='light']) .hero-cta {
        color: var(--sl-color-accent) !important;
    }

    .hero-cta::before {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: var(--sl-color-accent);
        z-index: -1;
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.4s var(--fs-ease-out);
    }

    .hero-cta:hover {
        color: #000 !important;
        border-color: transparent !important;
        box-shadow: 0 0 20px var(--fs-accent-glow) !important;
    }

    .hero-cta:hover::before {
        transform: scaleX(1);
        transform-origin: left;
    }

    @media (max-width: 900px) {
        .hero-v2 {
            padding: 4rem 1.5rem;
        }
        .hero-bg {
            background-image: var(--hero-bg-mobile, var(--hero-bg));
        }
    }

    @media (max-width: 480px) {
        .hero-v2 {
            padding: 3rem 1rem;
            margin-bottom: 2rem;
        }
        .hero-inner {
            padding: 1.5rem 0;
        }
        .hero-desc {
            font-size: 1rem;
        }
        .hero-cta {
            width: 100%;
            justify-content: center;
        }
    }
</style>
