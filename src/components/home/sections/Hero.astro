---
import { optimizeExternalImage } from '../../../utils/image-optimization'
import ArrowRight from '../../icons/ArrowRight.astro'

interface Props {
    title: string
    subtitle: string
    description: string
    ctaText: string
    ctaLink: string
    backgroundImages?: string[]
}

const { title, subtitle, description, ctaText, ctaLink, backgroundImages } = Astro.props

/**
 * 本地图片：已生成 768/1440 两档 JPEG 以及对应的 WebP/AVIF（public/assets/photo-together-768.jpg 等）。
 * 这里构建时生成 srcset 字符串，运行时由 <picture> 选择最佳格式与尺寸，避免硬编码 has900Variant。
 */
function getHeroVariants(src: string) {
    if (!src) return null
    if (src.startsWith('http')) {
        const large = optimizeExternalImage(src, 1600, 80)
        const small = optimizeExternalImage(src, 768, 80)
        return {
            fallback: large,
            jpgSrcSet: `${small} 768w, ${large} 1440w`,
            webpSrcSet: '',
            avifSrcSet: '',
            base: src,
        }
    }
    const dot = src.lastIndexOf('.')
    if (dot === -1) return { fallback: src, jpgSrcSet: '', webpSrcSet: '', avifSrcSet: '', base: src }
    const base = src.slice(0, dot)
    const ext = src.slice(dot)
    // 本地图片已为 hero 三图生成 768/1440 的 JPEG/WebP/AVIF 变体，其余单图也已生成 WebP/AVIF
    // 统一返回 768/1440 srcset，浏览器自动选择；若某尺寸缺失则 404 回退到 fallback，不影响首屏
    return {
        fallback: `${base}${ext}`,
        jpgSrcSet: `${base}-768.jpg 768w, ${base}-1440.jpg 1440w`,
        webpSrcSet: `${base}-768.webp 768w, ${base}-1440.webp 1440w`,
        avifSrcSet: `${base}-768.avif 768w, ${base}-1440.avif 1440w`,
        base,
    }
}

const images = (backgroundImages ?? []).map((src) => getHeroVariants(src)).filter(Boolean) as NonNullable<ReturnType<typeof getHeroVariants>>[]
---

{/* preload LCP: 优先 AVIF → WebP → JPEG，使用响应式 imagesrcset 命中 768/1440 */}
{images.length > 0 && images[0].avifSrcSet && (
    <link rel="preload" as="image" type="image/avif" imagesrcset={images[0].avifSrcSet} imagesizes="100vw" fetchpriority="high" />
)}
{images.length > 0 && images[0].webpSrcSet && (
    <link rel="preload" as="image" type="image/webp" imagesrcset={images[0].webpSrcSet} imagesizes="100vw" fetchpriority="high" />
)}
{images.length > 0 && (
    <link rel="preload" as="image" href={images[0].fallback} imagesrcset={images[0].jpgSrcSet || undefined} imagesizes="100vw" fetchpriority="high" />
)}

<section class="hero-v2 fs-full-bleed" role="region" aria-label="Hero">
    {images.length > 0 ? (
        images.map((img, i) => (
            <div
                class={`hero-bg hero-bg-${i}`}
                role="presentation"
                aria-hidden="true"
                data-parallax
                data-parallax-speed="0.25"
            >
                <picture>
                    {img.avifSrcSet && <source type="image/avif" srcset={img.avifSrcSet} sizes="100vw" />}
                    {img.webpSrcSet && <source type="image/webp" srcset={img.webpSrcSet} sizes="100vw" />}
                    <img
                        src={img.fallback}
                        srcset={img.jpgSrcSet || undefined}
                        sizes="100vw"
                        alt=""
                        width="1440"
                        height="960"
                        loading={i === 0 ? 'eager' : 'lazy'}
                        fetchpriority={i === 0 ? 'high' : 'low'}
                        decoding="async"
                    />
                </picture>
            </div>
        ))
    ) : (
        <div class="hero-bg hero-bg-0" role="presentation" aria-hidden="true" data-parallax data-parallax-speed="0.25"></div>
    )}
    <noscript>
        <style>.hero-bg { opacity: 1 !important; }</style>
    </noscript>
    <div class="hero-overlay" role="presentation" aria-hidden="true"></div>

    <div class="hero-inner">
        <div class="hero-label stagger-item">FORMULA STUDENT</div>
        <h1 class="hero-heading stagger-item">{title}</h1>
        {subtitle && <div class="hero-sub stagger-item">{subtitle}</div>}
        {description && <p class="hero-desc stagger-item">{description}</p>}

        <a
            class="hero-cta fs-cta-clip stagger-item"
            href={ctaLink}
            role="button"
            data-astro-prefetch="hover"
            aria-label={`${ctaText} - 开始探索赛车队内容`}
        >
            <span class="hero-cta-text">{ctaText}</span>
            <ArrowRight size={18} aria-hidden="true" />
        </a>
    </div>
</section>

<!-- 占位块：hero 是 fixed，需要推动后续内容到可视区以下 -->
<script>
    import { createLogger } from '../../../utils/logger'

    const log = createLogger('Hero')

    const bgLayers = document.querySelectorAll<HTMLElement>('.hero-bg')
    log.info('扫描背景图层', { found: bgLayers.length })

    if (bgLayers.length > 1) {
        let current = 0
        let interval: number
        const total = bgLayers.length

        function showSlide(index: number) {
            bgLayers.forEach((el, i) => {
                el.style.opacity = i === index ? '1' : '0'
                el.style.transition = 'opacity 1s ease-in-out'
            })
        }

        function nextSlide() {
            const prev = current
            current = (current + 1) % total
            showSlide(current)
            log.info('切换背景图', { from: prev, to: current, total })
        }

        function startCarousel() {
            interval = window.setInterval(nextSlide, 5000)
            log.info('自动轮播已启动', { intervalMs: 5000, total })
        }

        function stopCarousel() {
            clearInterval(interval)
            log.info('自动轮播已暂停（hover）')
        }

        const hero = document.querySelector('.hero-v2')
        hero?.addEventListener('mouseenter', stopCarousel)
        hero?.addEventListener('mouseleave', startCarousel)

        // init: show first, hide others
        bgLayers.forEach((el, i) => {
            el.style.opacity = i === 0 ? '1' : '0'
            el.style.transition = 'opacity 1s ease-in-out'
        })

        startCarousel()
    } else {
        log.info('背景图层数 ≤ 1，跳过轮播逻辑')
    }
</script>

<style>
    .hero-v2 {
        position: relative;
        margin-top: calc(-1 * var(--sl-navbar-height, 3.5rem));
        padding-top: var(--sl-navbar-height, 3.5rem);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: var(--fs-bg-base);
    }

    :global([data-theme='light']) .hero-v2 {
        background-color: var(--fs-bg-surface);
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        background-color: #0a0a0c;
        opacity: 0;
        /* 不再单独 brightness，统一由叠加层控制可读性 */
        filter: none;
        pointer-events: none;
        overflow: hidden;
    }
    .hero-bg-0 {
        opacity: 1;
    }
    .hero-bg picture,
    .hero-bg img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    /* 深色半透明叠加层：保证任意照片上白字均可达到 WCAG AA 对比度 */
    .hero-overlay {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.35) 45%, rgba(0,0,0,0.65) 100%),
            radial-gradient(ellipse at 50% 35%, rgba(0,0,0,0.25) 0%, transparent 70%);
        pointer-events: none;
    }

    /* 滚动提示：底部居中下滑箭头，暗示首屏之下仍有内容 */
    .hero-v2::after {
        content: '';
        position: absolute;
        bottom: 1.5rem;
        left: calc(50% - 6px);
        width: 12px;
        height: 12px;
        border-left: 2px solid rgba(255, 255, 255, 0.75);
        border-bottom: 2px solid rgba(255, 255, 255, 0.75);
        transform: rotate(-45deg);
        animation: heroScrollHint 2.2s var(--ease-out) infinite;
        z-index: 3;
        pointer-events: none;
    }

    @keyframes heroScrollHint {
        0%,
        100% {
            opacity: 0.35;
            margin-top: 0;
        }
        50% {
            opacity: 1;
            margin-top: 6px;
        }
    }

    .hero-inner {
        position: relative;
        z-index: 3;
        text-align: center;
        padding: 4rem 2rem;
        max-width: 900px;
    }

    .hero-label {
        display: inline-block;
        color: var(--fs-color-on-accent); /* 白字蓝底徽章，始终在图片上可读 */
        background: rgba(59,130,246,0.9);
        border: 1px solid rgba(255,255,255,0.2);
        padding: 0.35rem 0.85rem;
        font-weight: 800;
        letter-spacing: 4px;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
        font-size: 0.75rem;
        font-family: 'Space Grotesk', system-ui, sans-serif;
        text-shadow: none;
        backdrop-filter: blur(6px);
    }

    .hero-v2 .hero-heading {
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: clamp(3rem, 7vw, 5rem);
        margin: 0 0 1rem 0;
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 1;
        color: var(--fs-color-on-image) !important;
        text-shadow: 0 2px 20px rgba(0,0,0,0.55), 0 8px 32px rgba(0,0,0,0.45);
        border-bottom: none;
        padding-bottom: 0;
        /* 文字发光效果 */
        animation: textGlow 3s ease-in-out infinite alternate;
    }

    @keyframes textGlow {
        from {
            text-shadow: 0 2px 20px rgba(0,0,0,0.55), 0 8px 32px rgba(0,0,0,0.45);
        }
        to {
            text-shadow: 0 2px 20px rgba(0,0,0,0.55), 0 8px 32px rgba(0,0,0,0.45), 0 0 40px rgba(59, 130, 246, 0.3);
        }
    }

    .hero-sub {
        color: var(--fs-color-on-image);
        margin-bottom: 1.25rem;
        font-weight: 700;
        font-size: clamp(1.25rem, 3vw, 1.75rem);
        text-shadow: 0 2px 12px rgba(0,0,0,0.5);
    }

    .hero-desc {
        color: var(--fs-color-on-image); /* theme-contrast:allow */
        opacity: 0.92;
        margin: 0 auto 2.5rem auto;
        max-width: 720px;
        line-height: 1.7;
        white-space: pre-line;
        font-size: clamp(1rem, 2vw, 1.2rem);
        text-shadow: 0 1px 10px rgba(0,0,0,0.45);
    }

    /* Hero CTA：实心品牌蓝底白字，保证 WCAG AA 4.5:1（#2563eb on white 5.16:1，#1d4ed8 hover 6.7:1） */
    .hero-cta {
        background: #2563eb !important;
        color: var(--fs-color-on-accent) !important;
        border-color: #2563eb !important;
        box-shadow: 0 8px 24px rgba(37,99,235,0.35);
        text-shadow: none;
        /* 微妙的脉冲动画吸引注意 */
        animation: ctaPulse 2s ease-in-out infinite;
    }
    .hero-cta::before {
        display: none;
    }

    @keyframes ctaPulse {
        0%, 100% {
            box-shadow: 0 8px 24px rgba(37,99,235,0.35);
        }
        50% {
            box-shadow: 0 8px 32px rgba(37,99,235,0.5), 0 0 0 4px rgba(37,99,235,0.1);
        }
    }

    @media (hover: hover) and (pointer: fine) {
        .hero-cta:hover {
            background: #1d4ed8 !important;
            border-color: #1d4ed8 !important;
            color: var(--fs-color-on-accent) !important;
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(29,78,216,0.45);
            animation: none;
        }
    }

    @media (max-width: 900px) {
        .hero-v2 {
            padding: 4rem 1.5rem;
        }
    }

    @media (max-width: 480px) {
        .hero-v2 {
            padding: 3rem 1rem;
            margin-bottom: 2rem;
        }
        .hero-inner {
            padding: 1.5rem 0;
        }
        .hero-desc {
            font-size: 1rem;
        }
        .hero-cta {
            width: 100%;
            justify-content: center;
        }
    }
</style>
