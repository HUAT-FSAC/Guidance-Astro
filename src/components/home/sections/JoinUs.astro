---
interface Props{
    backgroundImage?:string
}
const { backgroundImage } = Astro.props
const bgStyle = backgroundImage ? `--join-bg: url(${backgroundImage});` : ''
---

<section class="join-hero fs-full-bleed" role="region" aria-label="加入我们">
    <div class="join-bg" role="presentation" aria-hidden="true" style={bgStyle}></div>
    <div class="join-overlay" role="presentation" aria-hidden="true"></div>
    <div class="join-content">
        <h1 class="join-heading">加入我们</h1>
        <span class="join-sub">JOIN US</span>
        <a class="join-cta fs-cta-clip" href="/join/" role="button" data-astro-prefetch="hover">立即报名</a>
    </div>
</section>

<style>
    .join-hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: var(--fs-bg-base);
    }

    .join-bg {
        position: absolute;
        inset: 0;
        background-image: var(--join-bg);
        background-size: cover;
        background-position: center;
        opacity: 0.5;
        pointer-events: none;
    }

    .join-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 0%, var(--fs-color-overlay-soft) 40%, var(--fs-color-overlay-strong) 100%);
        pointer-events: none;
    }

    .join-content {
        position: relative;
        z-index: 3;
        text-align: center;
        padding: 4rem 2rem;
        max-width: 900px;
        border: 1px solid var(--fs-color-border-strong);
        border-radius: 4px;
    }

    .join-content .join-heading {
        font-size: clamp(3rem, 7vw, 5rem);
        margin: 0 0 1rem 0;
        font-weight: 900;
        letter-spacing: 0.1em;
        line-height: 1.1;
        color: var(--fs-color-on-image);
        text-shadow: 0 10px 30px var(--fs-color-overlay-soft);
    }

    .join-content .join-sub {
        display: block;
        color: var(--fs-color-on-image);
        font-size: 1.2rem;
        letter-spacing: 2px;
        margin: 0 0 2.5rem 0;
        font-weight: 400;
    }

    /* CTA 样式由共享工具类 .fs-cta-clip 提供（见 docs-global.css） */

    @media (max-width: 480px) {
        .join-content { padding: 1.5rem 0; }
        .join-cta { width: 100%; justify-content: center; }
    }
</style>
