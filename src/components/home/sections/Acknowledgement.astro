---
import type { Locale } from '../../../utils/i18n'
import { getLocaleFromPath, getTranslations } from '../../../utils/i18n'

interface Props {
    locale?: Locale
}

const { locale = getLocaleFromPath(Astro.url.pathname) } = Astro.props
const t = getTranslations(locale)
const ack = t.ack
---

<section class="acknowledgement">
    <div class="ack-container">
        <div class="ack-header" style="text-align: center; margin-bottom: 3rem;">
            <h2 class="ack-title">{ack.title}</h2>
            <span class="ack-subtitle">ACKNOWLEDGEMENT</span>
        </div>

        <div class="ack-content">
            {ack.blocks.map((block) =>
                block.blockquote ? (
                    <blockquote class="ack-quote">"{block.parts[0].text}"</blockquote>
                ) : (
                    <p>
                        {block.parts.map((part) =>
                            part.strong ? <strong>{part.text}</strong> : part.text
                        )}
                    </p>
                )
            )}

            <div class="ack-signature">
                <p>{ack.signature}</p>
                <p class="signature-text">{ack.thanks}</p>
            </div>
        </div>
    </div>
</section>

<style>
    .acknowledgement {
        position: relative;
        z-index: 2;
        padding: 4rem 0;
        background: var(--fs-color-aside-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--fs-border-subtle);
        border-radius: 2rem;
        margin: 3rem auto;
        max-width: 1400px;
    }

    :global([data-theme='light']) .acknowledgement {
        background: rgba(255, 255, 255, 0.6);
        border-color: var(--fs-border-subtle);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    .ack-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .ack-title {
        font-size: 3rem;
        font-weight: 800;
        text-align: center;
        margin-bottom: 0;
        color: var(--fs-color-heading);
        border-bottom: 3px solid var(--sl-color-accent);
        padding-bottom: 0.5rem;
        display: inline-block;
    }

    .ack-subtitle {
        display: block;
        margin-top: 0.75rem;
        font-size: 1rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--fs-color-heading);
        text-align: center;
    }

    .ack-content {
        line-height: 1.9;
        color: var(--fs-color-text);
        font-size: 1.05rem;
    }

    .ack-content p {
        margin-bottom: 1.5rem;
        text-align: justify;
    }

    .ack-content strong {
        color: var(--sl-color-accent);
        font-weight: 600;
    }

    .ack-quote,
    :global(.sl-markdown-content) .ack-quote {
        font-size: 1.5rem;
        font-weight: 700;
        text-align: center;
        color: var(--sl-color-accent);
        margin: 2rem 0;
        padding: 1.5rem 2rem;
        border-left: 4px solid var(--sl-color-accent);
        border-right: 4px solid var(--sl-color-accent);
        background: var(--fs-color-aside-bg);
        border-radius: 1rem;
        font-style: italic;
    }

    .ack-signature {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--fs-border-subtle);
        text-align: center;
    }

    .signature-text {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--sl-color-accent);
        margin-top: 1rem !important;
    }

    @media (max-width: 768px) {
        .acknowledgement {
            padding: 3rem 0;
            margin: 2rem auto;
        }

        .ack-container {
            padding: 0 1.5rem;
        }

        .ack-title {
            font-size: 1.75rem;
        }

        .ack-quote {
            font-size: 1.2rem;
            padding: 1rem;
        }
    }
</style>
