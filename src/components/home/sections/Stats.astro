---
import type { StatItem } from "../../../data/home";

interface Props {
    stats: StatItem[];
}

const { stats } = Astro.props;

// 解析数值和后缀（如 "50+" -> { num: 50, suffix: "+" }）
function parseValue(value: string) {
    const match = value.match(/^(\d+)(.*)$/);
    if (match) {
        return { num: parseInt(match[1]), suffix: match[2] || "" };
    }
    return { num: 0, suffix: value };
}
---

<div class="stats-bar reveal-upon-scroll">
    {
        stats.map((stat, index) => {
            const { num, suffix } = parseValue(stat.value);
            return (
                <div class="stat-item reveal-upon-scroll" style={`transition-delay: ${index * 0.15 + 0.1}s;`}>
                    <div class="value" data-target={num} data-suffix={suffix}>
                        0{suffix}
                    </div>
                    <div class="label">{stat.label}</div>
                </div>
            );
        })
    }
</div>

<script>
    import { destroyStatsCounters, initStatsCounters } from '../../../utils/stats-counter';

    initStatsCounters();
    document.addEventListener('astro:page-load', initStatsCounters);
    document.addEventListener('astro:before-swap', destroyStatsCounters);
</script>

<style>
    .stats-bar {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        padding: 4rem 2rem;
        max-width: 1400px;
        margin: 0 auto 4rem;
        border-bottom: 1px solid var(--fs-border-subtle);
        text-align: center;
    }

    .stat-item {
        padding: 2.5rem 2rem 3.5rem;
        border-radius: var(--radius-sm);
        background: linear-gradient(180deg, var(--fs-bg-elevated) 0%, var(--fs-bg-surface) 100%);
        border: 1px solid var(--fs-border-subtle);
        transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--card-shadow);
        position: relative;
        height: 200px;
        max-height: 200px;
        min-height: 200px;
        box-sizing: border-box;
        overflow: hidden;
    }
    
    .stat-item::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--sl-color-accent), transparent);
        opacity: 0;
        transition: opacity var(--transition-normal);
    }

    :global([data-theme="light"]) .stat-item {
        background: var(--fs-bg-surface);
        border-color: var(--fs-color-border);
        box-shadow: var(--card-shadow);
    }

    .stat-item:hover {
        transform: translateY(-5px);
        background: linear-gradient(180deg, var(--fs-bg-elevated) 0%, var(--fs-bg-surface) 100%);
        border-color: var(--fs-border-focus);
        box-shadow: var(--card-shadow-hover), 0 0 20px var(--fs-accent-glow);
    }

    .stat-item:hover::before {
        opacity: 1;
    }

    :global([data-theme="light"]) .stat-item:hover {
        background: var(--fs-bg-base);
        border-color: var(--fs-color-border-strong);
    }

    .stat-item .value {
        font-family: 'Space Grotesk', monospace;
        font-size: 4rem;
        font-weight: 800;
        line-height: 1;
        color: var(--fs-color-heading);
        text-shadow: 0 0 15px var(--fs-accent-glow);
        letter-spacing: -0.04em;
        text-align: center;
        height: 4rem;
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    :global([data-theme="light"]) .stat-item .value {
        text-shadow: none;
    }

    .stat-item .label {
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--sl-color-accent);
        text-align: center;
        line-height: 1.2;
        position: absolute;
        bottom: 1.5rem;
        left: 2rem;
        right: 2rem;
    }

    @media (max-width: 768px) {
        .stats-bar {
            grid-template-columns: 1fr;
            padding: 3rem 1rem;
            gap: 1.5rem;
        }

        .stat-item {
            height: 180px;
            padding: 2rem 1.5rem 3rem;
        }

        .stat-item .value {
            font-size: 3rem;
            height: 3rem;
        }

        .stat-item .label {
            bottom: 1rem;
            left: 1.5rem;
            right: 1.5rem;
        }
    }
</style>
