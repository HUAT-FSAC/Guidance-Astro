---
/**
 * 比赛倒计时组件
 * 展示下一场比赛距今的倒计时，已过期则显示回顾状态
 */
import { raceEvents } from '../../../data/home';
const primary = raceEvents.find(e => e.isPrimary) ?? raceEvents[0];
---

<section class="countdown-section" data-start-date={primary.startDate}>
    <div class="countdown-inner">
        <div class="countdown-header">
            <span class="countdown-label">赛前冲刺</span>
            <span class="countdown-subtitle">COUNTDOWN</span>
            <h2 class="countdown-event">{primary.name}</h2>
            <p class="countdown-meta">
                <span class="meta-icon">📍</span>{primary.location}
                <span class="meta-sep">·</span>
                <span class="meta-icon">📅</span>{primary.startDate} — {primary.endDate}
            </p>
        </div>

        <!-- 倒计时显示区 -->
        <div class="countdown-display" id="countdown-display">
            <div class="cd-unit">
                <span class="cd-num" id="cd-days">--</span>
                <span class="cd-label">天</span>
            </div>
            <span class="cd-sep">:</span>
            <div class="cd-unit">
                <span class="cd-num" id="cd-hours">--</span>
                <span class="cd-label">时</span>
            </div>
            <span class="cd-sep">:</span>
            <div class="cd-unit">
                <span class="cd-num" id="cd-minutes">--</span>
                <span class="cd-label">分</span>
            </div>
            <span class="cd-sep">:</span>
            <div class="cd-unit">
                <span class="cd-num" id="cd-seconds">--</span>
                <span class="cd-label">秒</span>
            </div>
        </div>

        <p class="countdown-ended hidden" id="countdown-ended">
            🏁 赛事已圆满结束，感谢所有人的付出！
        </p>

        <a href="/about-fs/" class="countdown-cta">了解更多赛事信息 →</a>
    </div>
</section>

<script>
    import { destroyCountdowns, initCountdowns } from '../../../utils/countdown';

    initCountdowns();
    document.addEventListener('astro:page-load', initCountdowns);
    document.addEventListener('astro:before-swap', destroyCountdowns);
</script>

<style>
    .countdown-section {
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        min-height: 100vh;
        padding: 4rem 2rem;
        background: linear-gradient(135deg,
            rgba(59, 130, 246, 0.08) 0%,
            transparent 60%
        );
        border-top: 1px solid var(--fs-border-subtle);
        border-bottom: 1px solid var(--fs-border-subtle);
    }

    :global([data-theme='light']) .countdown-section {
        background: linear-gradient(135deg,
            rgba(59, 130, 246, 0.06) 0%,
            rgba(255, 255, 255, 0) 60%
        );
        border-color: var(--fs-border-subtle);
    }

    .countdown-inner {
        max-width: 1000px;
        margin: 0;
        text-align: left;
        padding-left: 5rem;
        padding-top: 8rem;
    }

    .countdown-label {
        display: inline-block;
        font-size: 3rem;
        font-weight: 800;
        color: var(--fs-color-heading);
        border-bottom: 3px solid var(--sl-color-accent);
        padding-bottom: 0.5rem;
        margin-bottom: 0;
    }

    .countdown-subtitle {
        display: block;
        margin-top: 0.75rem;
        font-size: 1rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--fs-color-heading);
    }

    .countdown-event {
        font-size: clamp(3rem, 3.5vw, 2.2rem);
        font-weight: 2000;
        margin: 0 0 0.75rem 0;
        color: var(--fs-color-heading);
        line-height: 1.2;
    }

    .countdown-meta {
        font-size: 2rem;
        opacity: 1;
        margin: 0 0 2.5rem 0;
    }

    .meta-icon { margin-right: 1rem; }
    .meta-sep { margin: 1 2rem; opacity: 0.5; }

    /* ── 倒计时数字 ── */
    .countdown-display {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .cd-unit {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
        min-width: 90px;
        background: var(--fs-color-card-bg);
        border: 1px solid var(--fs-color-border);
        border-radius: 1rem;
        padding: 1.25rem 1rem;
        position: relative;
        overflow: hidden;
    }

    .cd-unit::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(59,130,246,0.06), transparent);
        pointer-events: none;
    }

    :global([data-theme='light']) .cd-unit {
        background: rgba(0, 0, 0, 0.02);
        border-color: var(--fs-color-border-strong);
    }

    .cd-num {
        font-size: clamp(2rem, 6vw, 3.5rem);
        font-weight: 900;
        color: var(--sl-color-accent);
        line-height: 1;
        font-variant-numeric: tabular-nums;
        letter-spacing: -1px;
    }

    .cd-label {
        font-size: 6rem;
        font-weight: 600;
        opacity: 0.6;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .cd-sep {
        font-size: 2.5rem;
        font-weight: 900;
        color: var(--sl-color-accent);
        opacity: 0.4;
        margin-bottom: 1.5rem;
        align-self: center;
    }

    /* ── 结束状态 ── */
    .countdown-ended {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 2rem;
        color: var(--sl-color-text);
    }

    .hidden { display: none !important; }

    /* ── CTA ── */
    .countdown-cta {
        display: inline-block;
        padding: 0.75rem 2rem;
        border-radius: 99px;
        border: 1.5px solid var(--sl-color-accent);
        color: var(--sl-color-accent);
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.25s ease;
    }

    .countdown-cta:hover {
        background: var(--sl-color-accent);
        color: var(--fs-bg-base);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px var(--fs-accent-glow);
    }

    @media (max-width: 480px) {
        .cd-unit { min-width: 68px; padding: 1rem 0.75rem; }
        .cd-sep  { font-size: 1.8rem; }
    }
</style>
