---
import type { RecruitmentContent } from '../../../data/home'

interface Props {
    content: RecruitmentContent
    href?: string
}

const { content, href = '/join/' } = Astro.props
---

<section class="recruitment-section reveal-upon-scroll">
    <div class="recruitment-container">
        <div class="recruitment-content reveal-upon-scroll" style="transition-delay: 0.1s;">
            <span class="badge">{content.badge}</span>
            <h2>{content.title}</h2>
            <p>{content.description}</p>
            <div class="departments">
                {content.departments.map((department) => (
                    <span class="dept">{department}</span>
                ))}
            </div>
            <a href={href} class="cta-button fs-cta-clip">
                {content.ctaText}
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
            </a>
        </div>
        <div class="recruitment-visual reveal-upon-scroll" style="transition-delay: 0.3s;">
            <div class="icon-grid">
                <div class="icon-item">🏎️</div>
                <div class="icon-item">💻</div>
                <div class="icon-item">🔩</div>
                <div class="icon-item">🏆</div>
            </div>
        </div>
    </div>
</section>

<style>
    .recruitment-section {
        position: relative;
        z-index: 2;
        padding: 4rem 2rem;
        background-color: var(--fs-bg-elevated);
        border-top: 1px solid var(--fs-border-subtle);
        border-bottom: 1px solid var(--fs-border-subtle);
    }

    :global([data-theme='light']) .recruitment-section {
        background-color: var(--fs-color-section-alt);
        border-color: var(--fs-border-subtle);
    }

    .recruitment-container {
        max-width: 1400px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 4rem;
        align-items: center;
    }

    .badge {
        display: inline-block;
        background: var(--sl-color-accent);
        color: var(--fs-bg-base);
        padding: 0.4rem 1rem;
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
    }

    .recruitment-content h2 {
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: clamp(2.5rem, 5vw, 3.5rem);
        font-weight: 900;
        margin: 0 0 1rem 0;
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--fs-color-heading);
    }

    .recruitment-content p {
        font-size: 1.1rem;
        line-height: 1.8;
        color: var(--fs-color-text-muted);
        margin-bottom: 2rem;
        max-width: 600px;
    }

    .departments {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
        align-items: center;
    }

    .dept {
        background: var(--fs-color-card-bg);
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--fs-color-heading);
        border: 1px solid var(--fs-color-border-strong);
        border-radius: var(--radius-sm);
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        box-sizing: border-box;
        transition: background 0.3s ease;
    }

    .dept:hover {
        background: var(--fs-color-surface-active);
        border-color: var(--sl-color-accent);
    }

    /* CTA 基础样式由共享工具类 .fs-cta-clip 提供（见 docs-global.css） */
    .cta-button svg {
        transition: transform var(--transition-normal);
    }

    .cta-button:hover svg {
        transform: translateX(4px);
    }

    .recruitment-visual {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .icon-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .icon-item {
        width: 100px;
        height: 100px;
        background: linear-gradient(180deg, var(--fs-bg-elevated) 0%, var(--fs-bg-surface) 100%);
        border: 1px solid var(--fs-border-subtle);
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        box-shadow: var(--card-shadow);
        animation: float 6s ease-in-out infinite;
    }

    :global([data-theme='light']) .icon-item {
        background: var(--fs-color-card-bg);
        border-color: var(--fs-border-subtle);
        box-shadow: var(--card-shadow);
    }

    .icon-item:nth-child(2) { animation-delay: 1.5s; }
    .icon-item:nth-child(3) { animation-delay: 3s; }
    .icon-item:nth-child(4) { animation-delay: 4.5s; }

    .icon-item:hover {
        transform: scale(1.1);
        background: linear-gradient(180deg, var(--fs-bg-elevated) 0%, var(--fs-bg-surface) 100%);
        border-color: var(--fs-border-focus);
        box-shadow: var(--card-shadow-hover), 0 0 20px var(--fs-accent-glow);
    }

    :global([data-theme='light']) .icon-item:hover {
        background: var(--fs-color-card-bg);
        border-color: var(--fs-color-border-strong);
    }

    @keyframes float {
        0%,
        100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    @media (prefers-reduced-motion: reduce) {
        .icon-item { animation: none; }
    }

    @media (max-width: 900px) {
        .recruitment-container {
            grid-template-columns: 1fr;
            gap: 3rem;
        }

        .recruitment-visual {
            order: -1;
        }

        .recruitment-content {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .departments {
            justify-content: center;
        }
    }

    @media (max-width: 600px) {
        .recruitment-section {
            padding: 3rem 1.25rem;
        }

        .recruitment-content h2 {
            font-size: 2rem;
        }

        .cta-button {
            width: 100%;
            justify-content: center;
        }

        .icon-grid {
            gap: 1rem;
        }

        .icon-item {
            width: 80px;
            height: 80px;
            font-size: 2rem;
        }
    }
</style>
