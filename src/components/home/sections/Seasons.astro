---
import type { SeasonItem } from "../../../data/home";

interface Props {
    seasons: SeasonItem[];
}

const { seasons } = Astro.props;
---

<section class="seasons-section reveal-upon-scroll" role="region" aria-label="关于赛车">
    <div class="seasons-header">
        <span class="seasons-label">关于赛车</span>
        <span class="seasons-subtitle">ABOUT THE RACE CAR</span>
    </div>

    <div class="seasons-carousel" data-seasons-carousel>
        {/* 左箭头 */}
        <button class="seasons-arrow seasons-arrow--left" data-arrow="prev" aria-label="上一组">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>

        {/* 轨道 */}
        <div class="seasons-track">
            {seasons.map((season, index) => (
                <div class={`seasons-slide ${index === 0 ? 'is-active' : ''}`} data-index={index}>
                    <div class="seasons-pair">
                        <div class="seasons-img seasons-img--left">
                            <img
                                src={season.carImg}
                                alt={`${season.year} 赛车`}
                                loading="lazy"
                                decoding="async"
                            />
                            <span class="seasons-year">{season.year}</span>
                        </div>
                        <div class="seasons-img seasons-img--right">
                            <img
                                src={season.explainImg}
                                alt={`${season.year} 解说`}
                                loading="lazy"
                                decoding="async"
                            />
                            <span class="seasons-tag">EXPLAIN</span>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        {/* 右箭头 */}
        <button class="seasons-arrow seasons-arrow--right" data-arrow="next" aria-label="下一组">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>

        {/* 指示器 */}
        <div class="seasons-dots">
            {seasons.map((_, index) => (
                <button class={`seasons-dot ${index === 0 ? 'is-active' : ''}`} data-dot={index} aria-label={`第 ${index + 1} 组`}></button>
            ))}
        </div>
    </div>
</section>

<style>
    .seasons-section {
        position: relative;
        z-index: 2;
        padding: 5rem 0;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        background: var(--sl-color-bg, #fff);
    }

    .seasons-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .seasons-label {
        display: inline-block;
        font-size: 3rem;
        font-weight: 800;
        color: var(--sl-color-text);
        line-height: 1.2;
        border-bottom: 3px solid var(--sl-color-accent);
        padding-bottom: 0.5rem;
    }

    .seasons-subtitle {
        display: block;
        margin-top: 0.75rem;
        font-size: 1rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        font-weight: 600;
        color: #ffffff;
    }

    .seasons-carousel {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .seasons-track {
        position: relative;
        width: 100%;
        overflow: hidden;
        border-radius: 4px;
        background: transparent;
    }

    .seasons-slide {
        display: none;
        animation: fadeSlide 0.5s var(--fs-ease-out);
    }

    .seasons-slide.is-active {
        display: block;
    }

    @keyframes fadeSlide {
        from { opacity: 0; transform: scale(0.97); }
        to { opacity: 1; transform: scale(1); }
    }

    .seasons-pair {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 2rem;
        padding: 0 4rem;
        align-items: start;
    }

    .seasons-img {
        position: relative;
        border-radius: 4px;
        overflow: hidden;
        aspect-ratio: 16 / 10;
    }

    .seasons-img img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 0.6s var(--fs-ease-out);
        cursor: default;
    }

    .seasons-img:hover img {
        transform: scale(1.03);
    }

    .seasons-year {
        position: absolute;
        top: 1rem;
        left: 1rem;
        background: var(--sl-color-accent);
        color: #fff;
        font-size: 0.85rem;
        font-weight: 700;
        padding: 0.3rem 0.8rem;
        letter-spacing: 1px;
    }

    .seasons-tag {
        position: absolute;
        bottom: 1rem;
        right: 1rem;
        color: rgba(255,255,255,0.7);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        background: rgba(0,0,0,0.4);
        padding: 0.2rem 0.6rem;
        backdrop-filter: blur(4px);
    }

    /* 箭头 */
    .seasons-arrow {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.2);
        background: rgba(0,0,0,0.5);
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        backdrop-filter: blur(8px);
    }

    .seasons-arrow:hover {
        background: var(--sl-color-accent);
        border-color: var(--sl-color-accent);
        transform: scale(1.1);
    }

    .seasons-arrow:active {
        transform: scale(0.95);
    }

    /* 指示器 */
    .seasons-dots {
        position: absolute;
        bottom: -2rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0.5rem;
    }

    .seasons-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.3);
        background: transparent;
        cursor: pointer;
        transition: all 0.3s ease;
        padding: 0;
    }

    .seasons-dot.is-active {
        background: var(--sl-color-accent);
        border-color: var(--sl-color-accent);
        transform: scale(1.3);
    }

    .seasons-dot:hover {
        border-color: var(--sl-color-accent);
    }

    @media (max-width: 768px) {
        .seasons-section {
            padding: 3rem 1rem 5rem;
        }

        .seasons-label {
            font-size: 2rem;
        }

        .seasons-pair {
            grid-template-columns: 1fr;
            gap: 1rem;
            padding: 0 1rem;
        }

        .seasons-arrow {
            width: 40px;
            height: 40px;
        }

        .seasons-arrow svg {
            width: 18px;
            height: 18px;
        }
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        document.querySelectorAll<HTMLElement>('[data-seasons-carousel]').forEach((carousel) => {
            const slides = carousel.querySelectorAll<HTMLElement>('[data-index]');
            const dots = carousel.querySelectorAll<HTMLElement>('[data-dot]');
            const prevBtn = carousel.querySelector<HTMLElement>('[data-arrow="prev"]');
            const nextBtn = carousel.querySelector<HTMLElement>('[data-arrow="next"]');
            let current = 0;

            function goTo(index: number) {
                slides[current].classList.remove('is-active');
                dots[current].classList.remove('is-active');
                current = (index + slides.length) % slides.length;
                slides[current].classList.add('is-active');
                dots[current].classList.add('is-active');
            }

            prevBtn?.addEventListener('click', () => goTo(current - 1));
            nextBtn?.addEventListener('click', () => goTo(current + 1));
            dots.forEach((dot) => {
                dot.addEventListener('click', () => {
                    goTo(Number(dot.getAttribute('data-dot')));
                });
            });
        });
    });
</script>
