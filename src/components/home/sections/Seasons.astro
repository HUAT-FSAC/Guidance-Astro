---
import type { SeasonItem } from "../../../data/home";

interface Props {
    seasons: SeasonItem[];
    labels?: {
        label: string;
        subtitle: string;
    };
    locale?: "zh" | "en";
}

const {
    seasons,
    labels = { label: "关于赛车", subtitle: "ABOUT THE RACE CAR" },
    locale = "zh",
} = Astro.props;
const isEnglish = locale === "en";
---

<section class="seasons-section reveal-upon-scroll" role="region" aria-label={labels.label}>
    <div class="seasons-header">
        <span class="seasons-label">{labels.label}</span>
        <span class="seasons-subtitle">{labels.subtitle}</span>
    </div>

    <div
        class="seasons-carousel"
        data-seasons-carousel
        role="region"
        aria-roledescription="carousel"
        aria-label={isEnglish ? "Race car seasons" : "赛车赛季轮播"}
    >
        {/* 左箭头 */}
        <button class="seasons-arrow seasons-arrow--left" data-arrow="prev" aria-label={isEnglish ? "Previous season" : "上一组"}>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>

        {/* 轨道 */}
        <div class="seasons-track" aria-live="polite" aria-atomic="true">
            {seasons.map((season, index) => (
                <div
                    class={`seasons-slide ${index === 0 ? 'is-active' : ''}`}
                    data-index={index}
                    role="group"
                    aria-roledescription="slide"
                    aria-label={`${index + 1} / ${seasons.length}`}
                    aria-hidden={index === 0 ? undefined : 'true'}
                >
                    <div class="seasons-pair">
                        <div class="seasons-img seasons-img--left">
                            <img
                                src={season.carImg}
                                alt={isEnglish ? `${season.year} race car` : `${season.year} 赛车`}
                                width="600"
                                height="380"
                                loading="lazy"
                                decoding="async"
                            />
                            <span class="seasons-year" aria-hidden="true">{season.year}</span>
                        </div>
                        <div class="seasons-img seasons-img--right">
                            {season.specs && season.specs.length > 0 ? (
                                <div class="seasons-specs">
                                    <table class="seasons-specs-table">
                                        <tbody>
                                            {(() => {
                                                const rows = []
                                                const specs = season.specs
                                                let i = 0
                                                while (i < specs.length) {
                                                    const spec = specs[i]
                                                    if (spec.fullWidth) {
                                                        rows.push(
                                                            <tr class="seasons-specs-row seasons-specs-row--full">
                                                                <th class="seasons-specs-th">{spec.label}</th>
                                                                <td class="seasons-specs-td seasons-specs-td--full" colspan="3" set:html={spec.value.replace(/\n/g, '<br/>')} />
                                                            </tr>
                                                        )
                                                        i++
                                                    } else {
                                                        const left = spec
                                                        const right = specs[i + 1]
                                                        rows.push(
                                                            <tr class="seasons-specs-row">
                                                                <th class="seasons-specs-th">{left.label}</th>
                                                                <td class="seasons-specs-td">{left.value}</td>
                                                                {right && !right.fullWidth ? (
                                                                    <>
                                                                        <th class="seasons-specs-th">{right.label}</th>
                                                                        <td class="seasons-specs-td">{right.value}</td>
                                                                    </>
                                                                ) : (
                                                                    <td class="seasons-specs-td seasons-specs-td--empty" colspan="2"></td>
                                                                )}
                                                            </tr>
                                                        )
                                                        i += (right && !right.fullWidth) ? 2 : 1
                                                    }
                                                }
                                                return rows
                                            })()}
                                        </tbody>
                                    </table>
                                </div>
                            ) : season.explainImg ? (
                                <>
                                    <img
                                        src={season.explainImg}
                                        alt={isEnglish ? `${season.year} explanation` : `${season.year} 解说`}
                                        width="600"
                                        height="380"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                    <span class="seasons-tag" aria-hidden="true">EXPLAIN</span>
                                </>
                            ) : null}
                        </div>
                    </div>
                </div>
            ))}
        </div>

        {/* 右箭头 */}
        <button class="seasons-arrow seasons-arrow--right" data-arrow="next" aria-label={isEnglish ? "Next season" : "下一组"}>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>

        {/* 指示器 */}
        <div class="seasons-dots" role="tablist" aria-label={isEnglish ? "Season navigation" : "赛季导航"}>
            {seasons.map((_, index) => (
                <button
                    class={`seasons-dot ${index === 0 ? 'is-active' : ''}`}
                    data-dot={index}
                    role="tab"
                    aria-label={isEnglish ? `Season ${index + 1}` : `第 ${index + 1} 组`}
                    aria-selected={index === 0 ? 'true' : 'false'}
                ></button>
            ))}
        </div>
    </div>
</section>

<style>
    .seasons-section {
        position: relative;
        z-index: 2;
        padding: 5rem 0;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        background: var(--fs-bg-base);
    }

    .seasons-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .seasons-label {
        display: inline-block;
        font-size: 3rem;
        font-weight: 800;
        color: var(--fs-color-heading);
        line-height: 1.2;
        border-bottom: 3px solid var(--sl-color-accent);
        padding-bottom: 0.5rem;
    }

    .seasons-subtitle {
        display: block;
        margin-top: 0.75rem;
        font-size: 1rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--fs-color-heading);
    }

    .seasons-carousel {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .seasons-track {
        position: relative;
        width: 100%;
        overflow: hidden;
        border-radius: 4px;
        background: transparent;
    }

    .seasons-slide {
        display: none;
    }

    .seasons-slide.is-active {
        display: block;
        animation: fadeSlide 0.3s var(--ease-out);
    }

    @keyframes fadeSlide {
        from { opacity: 0; transform: scale(0.98); }
        to { opacity: 1; transform: scale(1); }
    }

    .seasons-pair {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 2.5rem;
        padding: 0 4rem;
        align-items: start;
    }

    .seasons-img {
        position: relative;
        border-radius: 4px;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e5e7eb;
    }

    .seasons-img--left {
        aspect-ratio: 16 / 10;
    }

    .seasons-img img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 0.6s var(--fs-ease-out);
        cursor: default;
    }

    .seasons-img:hover img {
        transform: scale(1.03);
    }

    .seasons-year {
        position: absolute;
        top: 1rem;
        left: 1rem;
        background: var(--sl-color-accent);
        color: var(--fs-color-on-image);
        font-size: 0.85rem;
        font-weight: 700;
        padding: 0.3rem 0.8rem;
        letter-spacing: 1px;
    }

    .seasons-tag {
        position: absolute;
        bottom: 1rem;
        right: 1rem;
        color: var(--fs-color-on-image);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        background: rgba(0,0,0,0.4);
        padding: 0.2rem 0.6rem;
        backdrop-filter: blur(4px);
    }

    .seasons-specs {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: stretch;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 4px;
        padding: 1.25rem;
        box-sizing: border-box;
    }

    .seasons-specs-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

    .seasons-specs-row {
        border-bottom: 1px solid #f3f4f6;
        transition: background-color var(--transition-fast);
    }

    .seasons-specs-row:last-child {
        border-bottom: none;
    }

    @media (hover: hover) and (pointer: fine) {
        .seasons-specs-row:hover {
            background-color: #f9fafb;
        }
    }

    .seasons-specs-th {
        text-align: left;
        font-weight: 600;
        color: #374151;
        padding: 0.7rem 0.9rem;
        white-space: nowrap;
        width: 1%;
    }

    .seasons-specs-td {
        text-align: left;
        color: #6b7280;
        padding: 0.7rem 0.9rem;
        width: auto;
    }

    .seasons-specs-td--full {
        white-space: pre-line;
        line-height: 1.6;
    }

    .seasons-specs-td--empty {
        background: transparent;
    }

    /* 箭头 */
    .seasons-arrow {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: var(--fs-color-overlay-soft);
        color: var(--fs-color-on-image);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform var(--transition-fast), background var(--transition-fast);
        backdrop-filter: blur(8px);
    }

    /* 触摸设备不显示 hover 效果 */
    @media (hover: hover) and (pointer: fine) {
        .seasons-arrow:hover {
            background: var(--sl-color-accent);
            border-color: var(--sl-color-accent);
            transform: scale(1.08);
        }
    }

    .seasons-arrow:active {
        transform: scale(0.97);
    }

    /* 指示器 */
    .seasons-dots {
        position: absolute;
        bottom: -2rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0.5rem;
    }

    .seasons-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.3);
        background: transparent;
        cursor: pointer;
        transition: transform var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast);
        padding: 0;
    }

    .seasons-dot.is-active {
        background: var(--sl-color-accent);
        border-color: var(--sl-color-accent);
        transform: scale(1.2);
    }

    @media (hover: hover) and (pointer: fine) {
        .seasons-dot:hover {
            border-color: var(--sl-color-accent);
            transform: scale(1.1);
        }
    }

    @media (max-width: 768px) {
        .seasons-section {
            padding: 3rem 1rem 5rem;
        }

        .seasons-label {
            font-size: 2rem;
        }

        .seasons-pair {
            grid-template-columns: 1fr;
            gap: 1.25rem;
            padding: 0 1rem;
        }

        .seasons-specs {
            padding: 1rem;
        }

        .seasons-specs-th,
        .seasons-specs-td {
            padding: 0.5rem 0.6rem;
            font-size: 0.8rem;
        }

        .seasons-arrow {
            width: 40px;
            height: 40px;
        }

        .seasons-arrow svg {
            width: 18px;
            height: 18px;
        }
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        document.querySelectorAll<HTMLElement>('[data-seasons-carousel]').forEach((carousel) => {
            const slides = carousel.querySelectorAll<HTMLElement>('[data-index]');
            const dots = carousel.querySelectorAll<HTMLElement>('[data-dot]');
            const prevBtn = carousel.querySelector<HTMLElement>('[data-arrow="prev"]');
            const nextBtn = carousel.querySelector<HTMLElement>('[data-arrow="next"]');
            let current = 0;

            function goTo(index: number) {
                slides[current].classList.remove('is-active');
                slides[current].setAttribute('aria-hidden', 'true');
                dots[current].classList.remove('is-active');
                dots[current].setAttribute('aria-selected', 'false');
                current = (index + slides.length) % slides.length;
                slides[current].classList.add('is-active');
                slides[current].removeAttribute('aria-hidden');
                dots[current].classList.add('is-active');
                dots[current].setAttribute('aria-selected', 'true');
            }

            prevBtn?.addEventListener('click', () => goTo(current - 1));
            nextBtn?.addEventListener('click', () => goTo(current + 1));
            dots.forEach((dot) => {
                dot.addEventListener('click', () => {
                    goTo(Number(dot.getAttribute('data-dot')));
                });
            });

            carousel.addEventListener('keydown', (event: KeyboardEvent) => {
                if (event.key === 'ArrowLeft') {
                    event.preventDefault();
                    goTo(current - 1);
                } else if (event.key === 'ArrowRight') {
                    event.preventDefault();
                    goTo(current + 1);
                } else if (event.key === 'Home') {
                    event.preventDefault();
                    goTo(0);
                } else if (event.key === 'End') {
                    event.preventDefault();
                    goTo(slides.length - 1);
                }
            });
            if (!carousel.hasAttribute('tabindex')) carousel.setAttribute('tabindex', '0');
        });
    });
</script>
