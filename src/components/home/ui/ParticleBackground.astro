---
// 粒子背景组件 - 星空效果
// 逻辑见 src/utils/particle-background.ts（已抽离以便打包缓存与单测）
---

<canvas id="particleCanvas" class="particle-canvas"></canvas>

<script>
    import {
        destroyParticleBackground,
    initParticleBackground,
    } from '../../../utils/particle-background';

    initParticleBackground();
    document.addEventListener('astro:page-load', initParticleBackground);
    document.addEventListener('astro:before-swap', destroyParticleBackground);
</script>

<style>
    .particle-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: var(--z-background, 1);
        opacity: 0;
        transition: opacity 0.5s ease;
    }
</style>
