---
/**
 * 自定义 PageTitle 组件
 * 添加面包屑导航
 */
import Default from "@astrojs/starlight/components/PageTitle.astro";
import Breadcrumbs from "../docs/Breadcrumbs.astro";

// 检查是否是首页（不显示面包屑与多余 h1）
// Starlight 的 PageTitle 会渲染 <h1 id="_top">，首页已由 Hero 提供唯一 h1，需彻底不渲染而非 display:none
const rawPath = Astro.url.pathname;
const isHomePage = rawPath === '/' || rawPath === '' || rawPath === '/en/' || rawPath === '/en';
const isSplash =
    (Astro.props as { entry?: { data?: { template?: string } } })?.entry?.data?.template ===
        'splash' || isHomePage;
---

{/* 面包屑导航 - 仅文档页面显示 */}
{!isHomePage && <Breadcrumbs />}

{/* 默认页面标题：首页为 splash 模板，已由 Hero 提供唯一 h1，彻底不渲染避免空 h1 与多 h1 */}
{!isHomePage && !isSplash && <Default />}
