---
/**
 * 导航栏主题切换按钮 - 简洁版
 * 仅切换亮暗模式，不显示颜色选择菜单
 */
---

<button
    class="nav-theme-toggle"
    type="button"
    aria-label="切换主题"
    data-nav-theme-toggle
>
    <span class="icon-sun">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
    </span>
    <span class="icon-moon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
    </span>
</button>

<script is:inline>
;(function () {
    function getStoredTheme() {
        try {
            return localStorage.getItem('starlight-theme') || 'dark';
        } catch {
            return 'dark';
        }
    }

    function getEffectiveTheme() {
        const stored = getStoredTheme();
        if (stored === 'auto') {
            return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        return stored;
    }

    function setTheme(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        try {
            localStorage.setItem('starlight-theme', theme);
        } catch {}
    }

    function updateButtonState() {
        const theme = getEffectiveTheme();
        document.querySelectorAll('[data-nav-theme-toggle]').forEach((btn) => {
            btn.setAttribute('data-current-scheme', theme);
        });
    }

    function toggleTheme() {
        const current = getEffectiveTheme();
        const next = current === 'dark' ? 'light' : 'dark';
        setTheme(next);
        updateButtonState();
    }

    updateButtonState();
    document.querySelectorAll('[data-nav-theme-toggle]').forEach((btn) => {
        btn.addEventListener('click', toggleTheme);
    });

    if (window.matchMedia) {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateButtonState);
    }

    document.addEventListener('astro:page-load', () => {
        updateButtonState();
        document.querySelectorAll('[data-nav-theme-toggle]').forEach((btn) => {
            btn.addEventListener('click', toggleTheme);
        });
    });
})()
</script>

<style>
    .nav-theme-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        padding: 0;
        border: 1px solid rgba(0, 0, 0, 0.15);
        border-radius: 8px;
        background: transparent;
        color: #4a4a4a;
        cursor: pointer;
        transition: all 0.25s ease;
        flex-shrink: 0;
    }

    .nav-theme-toggle:hover {
        border-color: var(--sl-color-accent);
        color: var(--sl-color-accent);
        background: rgba(59, 130, 246, 0.08);
    }

    .icon-sun,
    .icon-moon {
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .icon-sun {
        opacity: 1;
        transform: rotate(0deg) scale(1);
    }

    .icon-moon {
        position: absolute;
        opacity: 0;
        transform: rotate(-90deg) scale(0.5);
    }

    [data-current-scheme='light'] .icon-sun {
        opacity: 0;
        transform: rotate(90deg) scale(0.5);
    }

    [data-current-scheme='light'] .icon-moon {
        opacity: 1;
        transform: rotate(0deg) scale(1);
    }

    :global([data-theme='light']) .nav-theme-toggle {
        border-color: rgba(0, 0, 0, 0.15);
        color: #4a4a4a;
    }

    :global([data-theme='light']) .nav-theme-toggle:hover {
        border-color: var(--sl-color-accent);
        color: var(--sl-color-accent);
        background: rgba(59, 130, 246, 0.08);
    }
</style>
