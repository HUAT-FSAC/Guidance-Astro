<style>
  .custom-header {
    display: flex;
    align-items: center;
    width: 100%;
    height: 100%;
    gap: 2rem;
  }
  .header-left {
    display: flex;
    align-items: center;
    gap: 3rem;
    text-decoration: none;
    min-width: 0;
  }
  .header-logo {
    height: 100px;
    width: auto;
  }
  .header-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
    white-space: nowrap;
    overflow: hidden;
  }
  .header-nav {
    display: flex;
    align-items: center;
    gap: 3em;
    margin-left: auto;
    height: 100%;
  }
  .header-nav a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.2s;
    position: relative;
  }
  .header-nav a:hover {
    color: var(--sl-color-text-accent);
  }
  .header-nav a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--sl-color-accent);
    transform: scaleX(0);
    transition: transform 0.2s;
  }
  .header-nav a:hover::after {
    transform: scaleX(1);
  }
  .nav-github {
    display: flex;
    align-items: center;
    color: var(--sl-color-gray-2);
  }
  .nav-github:hover {
    color: var(--sl-color-text-accent);
  }
</style>
