---
import Search from '@astrojs/starlight/components/Search.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getNavItems, isEnglishPath } from '../../utils/navigation';

const isEn = isEnglishPath(Astro.url.pathname);
const navItems = getNavItems(isEn ? 'en' : 'zh');
const homeHref = isEn ? '/en/' : '/';
const titleText = isEn ? 'HUAT FSAC' : '东风 HUAT 无人驾驶车队';
---

<div class="custom-header">
  <!-- 背景噪点层 -->
  <div class="header-noise" aria-hidden="true"></div>

  <!-- 底部扫描线 -->
  <div class="header-scanline" aria-hidden="true"></div>

  <div class="header-inner">
    <a href={homeHref} class="header-left">
      <picture class="header-logo-picture">
        <source srcset="/assets/logo.avif" type="image/avif" />
        <source srcset="/assets/logo.webp" type="image/webp" />
        <img
          src="/assets/logo.png"
          alt="HUAT FSAC"
          class="header-logo"
          width="512"
          height="201"
          loading="eager"
          decoding="async"
        />
      </picture>
      <span class="header-title">{titleText}</span>
    </a>

    <nav class="header-nav" aria-label={isEn ? 'Main navigation' : '主导航'}>
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href="https://github.com/HUAT-FSAC" target="_blank" class="nav-github">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <Search class="header-search" />
      <ThemeToggle />
      <LanguageSwitcher />
    </nav>
  </div>
</div>

<style>
  .custom-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0 1.5rem;
    background: #ffffff;
    box-sizing: border-box;
    overflow: visible;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1600px;
  }

  /* ======== Starlight 搜索按钮适配白色 header ======== */
  .header-search {
    --sl-color-search-button-bg: transparent;
    --sl-color-search-button-border: #d0d0d0;
    --sl-color-search-button-text: #4a4a4a;
  }

  .header-search button {
    border-color: #d0d0d0;
    color: #4a4a4a;
  }

  .header-search button:hover {
    border-color: var(--sl-color-accent);
    color: #1a1a1a;
  }

  .header-search kbd {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    padding: 0.15rem 0.35rem;
    font-size: 0.7rem;
    font-family: ui-monospace, monospace;
    background: #f5f5f5;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    color: var(--fs-color-text-muted);
    line-height: 1;
  }

  /* ======== 背景噪点层 ======== */
  .header-noise {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.35;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 25% 70%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1.5px 1.5px at 40% 15%, rgba(255,255,255,0.35), transparent),
      radial-gradient(1px 1px at 55% 80%, rgba(255,255,255,0.25), transparent),
      radial-gradient(1.5px 1.5px at 70% 30%, rgba(255,255,255,0.35), transparent),
      radial-gradient(1px 1px at 85% 60%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 15% 50%, rgba(255,255,255,0.2), transparent),
      radial-gradient(1.5px 1.5px at 60% 90%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 90% 10%, rgba(255,255,255,0.25), transparent),
      radial-gradient(1px 1px at 35% 40%, rgba(255,255,255,0.2), transparent),
      radial-gradient(1.5px 1.5px at 50% 55%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 75% 85%, rgba(255,255,255,0.25), transparent);
  }

  /* ======== 底部扫描线 ======== */
  .header-scanline {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255,255,255,0.08) 20%,
      rgba(59,130,246,0.3) 50%,
      rgba(255,255,255,0.08) 80%,
      transparent 100%
    );
    pointer-events: none;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 3rem;
    text-decoration: none;
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  /* <picture> 包装层：占位为 flex item，line-height:0 消除行内图片基线空隙 */
  .header-logo-picture {
    display: inline-flex;
    line-height: 0;
  }

  .header-logo {
    height: 72px;
    width: auto;
    object-fit: contain;
  }

  .header-title {
    font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a1a;
    white-space: nowrap;
    overflow: hidden;
    letter-spacing: 2px;
    text-shadow: none;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 3em;
    height: 100%;
    position: relative;
    z-index: 10;
  }

  .header-nav a {
    color: #4a4a4a;
    text-decoration: none;
    font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 1px;
    white-space: nowrap;
    transition: color 0.25s;
    position: relative;
  }

  .header-nav a:hover {
    color: var(--sl-color-accent);
    text-shadow: none;
  }

  /* 当前激活页面下划线指示器 */
  .header-nav a[aria-current="page"] {
    color: var(--sl-color-accent);
    text-shadow: none;
  }

  .header-nav a[aria-current="page"]::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: none;
  }

  .nav-github {
    display: flex;
    align-items: center;
    color: #4a4a4a;
  }

  .nav-github:hover {
    color: var(--sl-color-accent) !important;
    text-shadow: none;
  }

  /* ======== 覆盖 Starlight 默认 header 内边距 ======== */
  :global(.header) {
    padding: 0 !important;
    border-bottom: none !important;
    background-color: #ffffff !important;
  }

  /* ======== 响应式：移动端隐藏桌面导航，避免与 MobileNavigation 双重显示 ========
     使用 Starlight 的 50rem 断点（800px），与框架一致，避免介于 768-800px 的闪烁 */
  @media (max-width: 50rem) {
    .custom-header {
      padding: 0 1rem;
    }

    .header-left {
      gap: 0.75rem;
    }

    .header-logo {
      height: 32px;
    }

    .header-title {
      font-size: 0.95rem;
      letter-spacing: 0.5px;
      max-width: 42vw;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* 关键修复：桌面导航在移动端完全隐藏，由 MobileNavigation 接管 */
    .header-nav {
      display: none !important;
    }
  }

  @media (max-width: 480px) {
    .header-title {
      font-size: 0.85rem;
    }
    .custom-header {
      padding: 0 0.75rem;
    }
  }

  /* ======== 浅色模式 ======== */
  :global([data-theme='light']) .custom-header {
    background: var(--fs-bg-surface);
  }

  :global([data-theme='light']) .header-title {
    text-shadow: none;
  }

  :global([data-theme='light']) .header-nav a:hover,
  :global([data-theme='light']) .header-nav a[aria-current='page'],
  :global([data-theme='light']) .nav-github:hover {
    color: var(--sl-color-accent);
  }

  :global([data-theme='light']) .header-search button:hover {
    border-color: var(--sl-color-accent);
    color: var(--fs-color-heading);
  }

  :global([data-theme='light']) .header-logo {
    filter: none;
  }

  :global([data-theme='light']) .header-scanline {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.06) 20%,
      rgba(59, 130, 246, 0.35) 50%,
      rgba(0, 0, 0, 0.06) 80%,
      transparent 100%
    );
  }
</style>
