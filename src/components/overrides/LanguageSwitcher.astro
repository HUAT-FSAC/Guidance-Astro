---
const currentLocale = Astro.url.pathname.startsWith('/en/') ? 'en' : 'zh'
---

<div class="language-switcher" data-language-switcher>
    <button
        type="button"
        class="language-toggle"
        data-language-toggle
        aria-haspopup="true"
        aria-expanded="false"
        aria-label={currentLocale === 'en' ? 'Switch language' : '切换语言'}
    >
        <span class="language-toggle-label">{currentLocale === 'en' ? 'English' : '中文'}</span>
        <svg class="language-toggle-icon" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </button>

    <div
        class="language-menu"
        data-language-menu
        role="menu"
        aria-label={currentLocale === 'en' ? 'Select language' : '选择语言'}
    >
        <button
            type="button"
            class="language-option"
            data-language-option
            data-locale="zh"
            role="menuitem"
            aria-current={currentLocale === 'zh' ? 'true' : undefined}
        >
            中文
        </button>
        <button
            type="button"
            class="language-option"
            data-language-option
            data-locale="en"
            role="menuitem"
            aria-current={currentLocale === 'en' ? 'true' : undefined}
        >
            English
        </button>
    </div>
</div>

<script>
    import { setupLanguageSwitcherLifecycle } from '../../utils/language-switcher-controller'

    setupLanguageSwitcherLifecycle('[data-language-switcher]')
</script>

<style>
    .language-switcher {
        position: relative;
        display: flex;
        align-items: center;
        height: 100%;
    }

    .language-toggle {
        display: flex;
        align-items: center;
        gap: 0.5em;
        padding: 0.35em 0.75em;
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 6px;
        background: transparent;
        color: var(--fs-color-text-muted);
        font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 1px;
        cursor: pointer;
        transition: color 0.25s, border-color 0.25s, text-shadow 0.25s;
        white-space: nowrap;
    }

    .language-toggle:hover {
        color: var(--sl-color-accent);
        border-color: var(--sl-color-accent);
        text-shadow: 0 0 12px var(--fs-accent-glow);
    }

    .language-toggle[aria-expanded='true'] {
        color: var(--sl-color-accent);
        border-color: var(--sl-color-accent);
    }

    .language-toggle[aria-expanded='true'] .language-toggle-icon {
        transform: rotate(180deg);
    }

    .language-toggle-icon {
        transition: transform 0.2s ease;
    }

    .language-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 132px;
        padding: 0.35rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        background: var(--fs-bg-base, #0b1220);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-4px);
        transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
        z-index: 50;
    }

    .language-menu[data-open="true"] {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .language-option {
        display: block;
        width: 100%;
        padding: 0.5em 0.9em;
        border: none;
        border-radius: 5px;
        background: transparent;
        color: var(--fs-color-text);
        font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;
        font-size: 0.95rem;
        text-align: left;
        cursor: pointer;
        transition: color 0.2s, background-color 0.2s;
    }

    .language-option:hover {
        color: var(--fs-color-heading);
        background: var(--fs-color-surface-hover);
    }

    .language-option[aria-current='true'] {
        color: var(--sl-color-accent);
        font-weight: 600;
    }

    :global([data-theme='light']) .language-toggle {
        border-color: rgba(0, 0, 0, 0.25);
    }

    :global([data-theme='light']) .language-toggle:hover,
    :global([data-theme='light']) .language-toggle[aria-expanded='true'] {
        color: var(--sl-color-accent);
        border-color: var(--sl-color-accent);
    }

    :global([data-theme='light']) .language-menu {
        background: var(--fs-bg-surface, #ffffff);
        border-color: rgba(0, 0, 0, 0.12);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    :global([data-theme='light']) .language-option:hover {
        background: rgba(0, 0, 0, 0.06);
    }

    @media (max-width: 768px) {
        .language-toggle {
            font-size: 0.85rem;
            padding: 0.3em 0.55em;
        }
    }
</style>
