---
interface Props {
    theme?: 'light' | 'dark';
}

const { theme = 'dark' } = Astro.props;

const repo = import.meta.env.GISCUS_REPO || 'HUAT-FSAC/Guidance-Astro';
const repoId = import.meta.env.GISCUS_REPO_ID || '';
const category = import.meta.env.GISCUS_CATEGORY || 'Announcements';
const categoryId = import.meta.env.GISCUS_CATEGORY_ID || '';

const giscusEnabled = Boolean(repoId && categoryId);

const giscusConfig = {
    repo,
    repoId,
    category,
    categoryId,
    mapping: "pathname",
    strict: "0",
    reactionsEnabled: "1",
    emitMetadata: "0",
    inputPosition: "top",
    lang: "zh-CN",
};
---

{
    giscusEnabled && (
        <script
            src="https://giscus.app/client.js"
            data-repo={giscusConfig.repo}
            data-repo-id={giscusConfig.repoId}
            data-category={giscusConfig.category}
            data-category-id={giscusConfig.categoryId}
            data-mapping={giscusConfig.mapping}
            data-strict={giscusConfig.strict}
            data-reactions-enabled={giscusConfig.reactionsEnabled}
            data-emit-metadata={giscusConfig.emitMetadata}
            data-input-position={giscusConfig.inputPosition}
            data-lang={giscusConfig.lang}
            data-theme={theme}
            crossorigin="anonymous"
            async
        />
    )
}