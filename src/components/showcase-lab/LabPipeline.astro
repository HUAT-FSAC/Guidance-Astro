---
import type { ShowcaseSubsystem } from '../../data/showcase-lab'

interface Props {
    subsystems: ShowcaseSubsystem[]
    activeId: string
    closedLoopLabel: string
}

const { subsystems, activeId, closedLoopLabel } = Astro.props
const active = subsystems.find((item) => item.id === activeId) ?? subsystems[0]

const icons: Record<string, string> = {
    perception:
        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>',
    localization:
        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>',
    planning:
        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>',
    control:
        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
    actuation:
        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>',
}
---

<section class="lab-pipeline" aria-label={closedLoopLabel}>
    <div class="lab-kicker">{closedLoopLabel}</div>
    <div class="lab-pipeline-track" id="showcase-subsystem-tabs">
        {subsystems.map((subsystem, index) => (
            <button
                class:list={['lab-pipeline-step', { 'is-active': subsystem.id === active.id }]}
                type="button"
                data-subsystem-id={subsystem.id}
                aria-label={subsystem.label}
                aria-pressed={subsystem.id === active.id ? 'true' : 'false'}
            >
                <span class="lab-pipeline-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="lab-pipeline-icon" aria-hidden="true" set:html={icons[subsystem.id] || ''}></span>
                <span class="lab-pipeline-label">{subsystem.label}</span>
            </button>
        ))}
    </div>
    <div class="lab-pipeline-detail subsystem-panel" id="showcase-subsystem-panel">
        <span class="lab-pipeline-eyebrow" id="showcase-subsystem-eyebrow">{active.eyebrow}</span>
        <h3 class="lab-pipeline-headline" id="showcase-subsystem-headline">{active.headline}</h3>
        <p class="lab-pipeline-summary" id="showcase-subsystem-summary">{active.summary}</p>
        <ul class="lab-pipeline-list" id="showcase-subsystem-list">
            {active.bullets.map((bullet) => (
                <li>{bullet}</li>
            ))}
        </ul>
    </div>
</section>
