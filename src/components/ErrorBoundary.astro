---
/**
 * 错误边界组件
 * 捕获子组件中的错误，显示友好的错误信息
 *
 * @example
 * ```astro
 * <ErrorBoundary fallback="加载失败" showErrorDetails={true}>
 *     <MyComponent />
 * </ErrorBoundary>
 * ```
 *
 * 文案按当前 locale 从 `src/content/i18n/{zh,en}.json` 的 `errors.boundary` 取词（#204 / D-016）；
 * 客户端脚本所需的串经容器上的 `data-error-texts` 传入，避免把词表打进客户端 bundle。
 */
import { getLocaleFromPath, getTranslations } from "../utils/i18n";

const t = getTranslations(getLocaleFromPath(Astro.url.pathname));
const boundaryTexts = t.errors.boundary;

interface Props {
    /** 错误时显示的提示信息 */
    fallback?: string;
    /** 是否显示错误详情（仅开发环境建议开启） */
    showErrorDetails?: boolean;
    /** 是否允许尝试恢复 */
    allowRecover?: boolean;
}

const {
    fallback = boundaryTexts.defaultFallback,
    showErrorDetails = false,
    allowRecover = true
} = Astro.props;
---

<slot />

<div
    id="error-boundary"
    class="error-boundary"
    style="display: none;"
    data-allow-recover={allowRecover}
    data-error-texts={JSON.stringify(boundaryTexts)}
>
    <div class="error-container">
        <div class="error-badge" id="error-badge">{boundaryTexts.badgeRecoverable}</div>
        <div class="error-icon" id="error-icon">⚠️</div>
        <h2 class="error-title" id="error-title">{boundaryTexts.title}</h2>
        <p class="error-message">{fallback}</p>
        {showErrorDetails && (
            <div class="error-details">
                <h3>{boundaryTexts.detailsTitle}</h3>
                <pre id="error-stack" class="error-stack"></pre>
            </div>
        )}
        <div class="error-actions">
            {allowRecover && (
                <button class="error-recover" id="error-recover-btn">
                    🔄 {boundaryTexts.tryRecover}
                </button>
            )}
            <button class="error-retry" onclick="window.location.reload()">
                {boundaryTexts.reloadPage}
            </button>
            <button class="error-report" id="error-report-btn">
                📝 {boundaryTexts.report}
            </button>
        </div>
    </div>
</div>

<script>
    import { type ErrorInfo, ErrorType, registerErrorHandler, setupGlobalErrorHandlers } from "../utils/error-handler";

    // 错误分类
    type ErrorSeverity = 'recoverable' | 'fatal';

    // 客户端所需的本地化文案（SSR 经容器 data-error-texts 注入，取不到时保持 DOM 原文案）
    type BoundaryTexts = Partial<Record<
        | 'badgeRecoverable' | 'badgeFatal' | 'title' | 'titleFatal'
        | 'reportSubject' | 'reportErrorLabel' | 'reportPageLabel'
        | 'reportTimeLabel' | 'reportBrowserLabel' | 'unknownError',
        string
    >>;

    function readBoundaryTexts(): BoundaryTexts {
        try {
            const raw = document.getElementById("error-boundary")?.getAttribute("data-error-texts");
            return raw ? (JSON.parse(raw) as BoundaryTexts) : {};
        } catch {
            return {};
        }
    }

    const boundaryTexts = readBoundaryTexts();

    function classifyError(error: ErrorInfo): ErrorSeverity {
        // 网络错误和图片错误通常可恢复
        if (error.type === ErrorType.NETWORK_ERROR || error.type === ErrorType.IMAGE_ERROR) {
            return 'recoverable';
        }
        // 脚本错误根据消息判断
        if (error.message?.includes('ChunkLoadError') || 
            error.message?.includes('Loading chunk')) {
            return 'recoverable';
        }
        return 'fatal';
    }

    // 上报错误到 Umami
    function reportErrorToUmami(error: ErrorInfo, severity: ErrorSeverity) {
        const umami = (window as unknown as { umami?: { track: (e: string, d: Record<string, unknown>) => void } }).umami;
        if (umami?.track) {
            umami.track('error-boundary', {
                type: error.type,
                severity,
                message: error.message?.slice(0, 100),
                url: error.url,
            });
        }
    }

    // 设置全局错误处理器
    setupGlobalErrorHandlers();

    // 使用 Symbol 防止重复清理
    const cleanupSymbol = Symbol.for('errorBoundaryCleanup');
    const controller = new AbortController();
    let currentError: ErrorInfo | null = null;

    // 注册错误处理器
    const unregister = registerErrorHandler(ErrorType.COMPONENT_ERROR, (error: ErrorInfo) => {
        const errorBoundary = document.getElementById("error-boundary");
        if (!errorBoundary) return;

        currentError = error;
        const severity = classifyError(error);
        
        // 更新 UI 基于错误严重程度
        const badge = document.getElementById("error-badge");
        const icon = document.getElementById("error-icon");
        const title = document.getElementById("error-title");
        const recoverBtn = document.getElementById("error-recover-btn");
        
        if (severity === 'fatal') {
            if (badge) {
                if (boundaryTexts.badgeFatal) badge.textContent = boundaryTexts.badgeFatal;
                badge.classList.add('fatal');
            }
            if (icon) icon.textContent = '💥';
            if (title && boundaryTexts.titleFatal) title.textContent = boundaryTexts.titleFatal;
            if (recoverBtn) recoverBtn.style.display = 'none';
        } else {
            if (badge) {
                if (boundaryTexts.badgeRecoverable) badge.textContent = boundaryTexts.badgeRecoverable;
                badge.classList.remove('fatal');
            }
            if (icon) icon.textContent = '⚠️';
            if (title && boundaryTexts.title) title.textContent = boundaryTexts.title;
            if (recoverBtn) recoverBtn.style.display = 'inline-flex';
        }

        const errorStack = document.getElementById("error-stack");
        if (errorStack && error.stack) {
            errorStack.textContent = error.stack;
        }

        reportErrorToUmami(error, severity);
        errorBoundary.style.display = "flex";
    });

    // 恢复按钮处理
    document.getElementById("error-recover-btn")?.addEventListener("click", () => {
        const errorBoundary = document.getElementById("error-boundary");
        if (errorBoundary) {
            errorBoundary.style.display = "none";
            currentError = null;
        }
    });

    // 报告问题按钮
    document.getElementById("error-report-btn")?.addEventListener("click", () => {
        const subject = encodeURIComponent(boundaryTexts.reportSubject ?? '');
        const body = encodeURIComponent(
            `${boundaryTexts.reportErrorLabel ?? ''}:\n${currentError?.message || boundaryTexts.unknownError || ''}\n\n` +
            `${boundaryTexts.reportPageLabel ?? ''}: ${window.location.href}\n` +
            `${boundaryTexts.reportTimeLabel ?? ''}: ${new Date().toISOString()}\n` +
            `${boundaryTexts.reportBrowserLabel ?? ''}: ${navigator.userAgent}`
        );
        window.open(`mailto:support@huat-fsac.eu.org?subject=${subject}&body=${body}`, '_blank');
    });

    // 统一清理函数
    function cleanup() {
        const win = window as unknown as { [key: symbol]: boolean };
        if (win[cleanupSymbol]) return;
        win[cleanupSymbol] = true;
        unregister();
        controller.abort();
    }

    document.addEventListener("astro:page-load", cleanup, { signal: controller.signal });
    window.addEventListener("beforeunload", cleanup, { signal: controller.signal });
</script>

<style>
    .error-boundary {
        position: fixed;
        inset: 0;
        z-index: var(--z-modal, 10000);
        background: rgba(0, 0, 0, 0.9);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .error-container {
        background: var(--sl-color-bg);
        border-radius: 1rem;
        padding: 2.5rem;
        max-width: 500px;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
        border: 1px solid var(--sl-color-gray-5);
        position: relative;
    }

    .error-badge {
        position: absolute;
        top: -0.75rem;
        left: 50%;
        transform: translateX(-50%);
        background: #27ae60;
        color: var(--fs-color-on-accent);
        padding: 0.25rem 1rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .error-badge.fatal {
        background: #e74c3c;
    }

    .error-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
    }

    .error-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--sl-color-text);
        margin: 0 0 1rem 0;
    }

    .error-message {
        font-size: 1rem;
        color: var(--sl-color-text-gray);
        line-height: 1.6;
        margin: 0 0 1.5rem 0;
    }

    .error-details {
        background: var(--sl-color-gray-6);
        border-radius: 0.5rem;
        padding: 1rem;
        margin-bottom: 1.5rem;
        text-align: left;
    }

    .error-details h3 {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--sl-color-text);
        margin: 0 0 0.75rem 0;
    }

    .error-stack {
        font-size: 0.75rem;
        color: var(--sl-color-gray-2);
        background: var(--sl-color-gray-7);
        padding: 0.75rem;
        border-radius: 0.375rem;
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-all;
        margin: 0;
    }

    .error-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
    }

    .error-retry,
    .error-recover,
    .error-report {
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .error-retry {
        background: var(--sl-color-accent);
        color: #000;
    }

    .error-recover {
        background: #27ae60;
        color: var(--fs-color-on-accent);
    }

    .error-report {
        background: var(--sl-color-gray-5);
        color: var(--sl-color-text);
    }

    .error-retry:hover,
    .error-recover:hover,
    .error-report:hover {
        transform: translateY(-2px);
    }

    .error-retry:hover {
        box-shadow: 0 4px 12px var(--fs-accent-glow);
    }

    .error-recover:hover {
        box-shadow: 0 4px 12px rgba(39, 174, 96, 0.4);
    }

    @media (max-width: 640px) {
        .error-container {
            padding: 2rem;
            margin: 1rem;
        }

        .error-icon {
            font-size: 3rem;
        }

        .error-title {
            font-size: 1.5rem;
        }

        .error-actions {
            flex-direction: column;
        }

        .error-retry,
        .error-recover,
        .error-report {
            width: 100%;
            justify-content: center;
        }
    }
</style>
