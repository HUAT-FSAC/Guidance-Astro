---
import type { Props } from "@astrojs/starlight/props";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Giscus from "./Giscus.astro";

interface DocFrontmatter {
    title: string;
    comments?: boolean;
    [key: string]: unknown;
}

const { entry } = Astro.props as Props & { entry?: { data: DocFrontmatter } };
const frontmatter: DocFrontmatter = entry?.data ?? { title: "" };

const showComments = entry && frontmatter.comments !== false;
---

<StarlightPage frontmatter={frontmatter} {...Astro.props}>
    <slot />
    {showComments && <Giscus theme="dark" />}
</StarlightPage>